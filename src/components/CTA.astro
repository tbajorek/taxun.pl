---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  variant?: 'dark' | 'accent';
}
const {
  title = 'Porozmawiajmy o księgowości Twojej firmy',
  description = 'Bezpłatna konsultacja online. W 30 minut pokażemy, jak możemy uprościć Twoją księgowość i odzyskać Twój czas.',
  primaryLabel = 'Wyceń obsługę swojej firmy',
  primaryHref = '/wycena',
  secondaryLabel = site.phoneDisplay,
  secondaryHref = `tel:${site.phoneHref}`,
  variant = 'dark',
} = Astro.props;
---
<section class={`cta cta--${variant}`}>
  <div class="container">
    <div class="cta__panel reveal">
      <div class="cta__bg" aria-hidden="true"></div>
      <div class="cta__content">
        <h2>{title}</h2>
        <p>{description}</p>
        <div class="cta__buttons">
          <a href={primaryHref} class="btn btn--accent btn--lg">
            <span>{primaryLabel}</span>
            <Icon name="arrow-right" size={18}/>
          </a>
          <a href={secondaryHref} class="btn btn--ghost-light btn--lg">
            <Icon name="phone" size={18}/>
            <span>{secondaryLabel}</span>
          </a>
        </div>
        <ul class="cta__perks">
          <li><Icon name="check-circle" size={16}/> Bez zobowiązań</li>
          <li><Icon name="check-circle" size={16}/> Szybki kontakt</li>
          <li><Icon name="check-circle" size={16}/> Pełna poufność danych</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
.cta { padding: clamp(3rem, 6vw, 5rem) 0; }
.cta__panel {
  position: relative;
  border-radius: var(--radius-2xl);
  padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.75rem, 5vw, 3.5rem);
  overflow: hidden;
  color: var(--white);
  isolation: isolate;
}
.cta--dark .cta__panel { background: var(--ink-900); }
.cta--accent .cta__panel { background: linear-gradient(135deg, var(--accent-600), var(--accent-500)); color: var(--ink-950); }

.cta__bg {
  position: absolute; inset: 0; z-index: -1;
  background:
    radial-gradient(60% 70% at 100% 0%, rgba(16,185,129,0.45), transparent 60%),
    radial-gradient(40% 60% at 0% 100%, rgba(16,185,129,0.18), transparent 60%);
}
.cta--accent .cta__bg {
  background:
    radial-gradient(40% 60% at 0% 0%, rgba(255,255,255,0.35), transparent 60%),
    radial-gradient(60% 60% at 100% 100%, rgba(6,17,42,0.2), transparent 60%);
}

.cta__content { max-width: 680px; }
.cta__content h2 {
  color: inherit;
  font-size: clamp(1.875rem, 3.5vw, 2.75rem);
  letter-spacing: -0.025em;
}
.cta__content p {
  color: rgba(255,255,255,0.78);
  margin-top: 1rem;
  font-size: 1.0625rem;
  line-height: var(--leading-relaxed);
}
.cta--accent .cta__content p { color: rgba(6,17,42,0.78); }

.cta__buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 2rem;
}
/* Na telefonie przyciski jeden pod drugim - w rzędzie nie mieści się nawet jeden. */
@media (max-width: 560px) {
  .cta__buttons { flex-direction: column; align-items: stretch; }
  .cta__buttons .btn { width: 100%; }
}

.cta__perks {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 1.5rem;
  margin-top: 1.75rem;
  font-size: 0.9375rem;
  color: rgba(255,255,255,0.85);
}
.cta--accent .cta__perks { color: rgba(6,17,42,0.85); }
.cta__perks li { display: inline-flex; align-items: center; gap: 0.45rem; }
.cta__perks svg { color: var(--accent-400); }
.cta--accent .cta__perks svg { color: var(--ink-950); }
</style>
