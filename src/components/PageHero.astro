---
import HeroPhoto from './HeroPhoto.astro';
import Icon from './Icon.astro';
import { image as findImage } from '../data/images';

interface Crumb { label: string; href?: string }
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  breadcrumbs?: Crumb[];
  align?: 'left' | 'center';
  compact?: boolean;
  /**
   * Nazwa pliku z `src/assets/images/`, bez rozszerzenia - `image="ksiegowosc"`
   * to `src/assets/images/ksiegowosc.jpg`. Bez tego pliku blok powitalny
   * wygląda dokładnie tak jak dotąd, jednokolumnowo. Brak obrazka nie jest
   * błędem, bo strona ma się zbudować, zanim ktoś zdjęcie przygotuje.
   */
  image?: string;
}
const { eyebrow, title, description, breadcrumbs, align = 'left', compact = false, image } = Astro.props;

// Zdjęcie odpada przy `align="center"` - kolumna tekstu wyśrodkowana obok kadru
// wygląda jak pomyłka, a nie jak decyzja.
const photo = image && align !== 'center' ? findImage(image) : null;
---
<section class={`page-hero ${align === 'center' ? 'page-hero--center' : ''} ${compact ? 'page-hero--compact' : ''}`}>
  <div class="page-hero__bg" aria-hidden="true">
    <div class="page-hero__grid"></div>
    <div class="page-hero__glow"></div>
  </div>
  <div class={`container page-hero__inner ${photo ? 'page-hero__inner--with-photo' : ''}`}>
    <div class="page-hero__text">
      {breadcrumbs && (
        <nav class="breadcrumbs" aria-label="Okruszki">
          <ol>
            <li><a href="/">Start</a></li>
            {breadcrumbs.map((c, i) => (
              <li>
                <Icon name="chevron-right" size={12} />
                {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1 class="page-hero__title">{title}</h1>
      {description && <p class="page-hero__lede lede">{description}</p>}
      <slot />
    </div>
    {photo && <HeroPhoto photo={photo} />}
  </div>
</section>

<style>
.page-hero {
  position: relative;
  padding: clamp(5rem, 9vw, 7.5rem) 0 clamp(3rem, 6vw, 5rem);
  background: linear-gradient(180deg, var(--ink-950) 0%, var(--ink-900) 100%);
  color: var(--white);
  overflow: hidden;
  isolation: isolate;
}
.page-hero--compact { padding: clamp(3.5rem, 7vw, 5rem) 0 clamp(2rem, 4vw, 3rem); }
.page-hero--center { text-align: center; }
.page-hero--center .breadcrumbs ol { justify-content: center; }
.page-hero__bg {
  position: absolute; inset: 0;
  z-index: -1;
}
.page-hero__grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse at top, black 30%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse at top, black 30%, transparent 80%);
}
.page-hero__glow {
  position: absolute;
  top: -10%; right: -10%;
  width: 60%; aspect-ratio: 1;
  background: radial-gradient(circle, rgba(16,185,129,0.22), transparent 60%);
  filter: blur(20px);
}

.breadcrumbs ol {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.875rem;
  color: var(--text-on-dark-muted);
  margin-bottom: 1.5rem;
}
.breadcrumbs li {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
}
.breadcrumbs a {
  color: var(--text-on-dark-muted);
  transition: color var(--transition-fast);
}
.breadcrumbs a:hover { color: var(--white); }
.breadcrumbs li:last-child span { color: var(--white); }

.page-hero__title {
  color: var(--white);
  max-width: 22ch;
  font-size: clamp(2.25rem, 5vw, 3.75rem);
  letter-spacing: -0.03em;
}
.page-hero--center .page-hero__title { margin-inline: auto; }
.page-hero__lede {
  color: var(--text-on-dark-muted);
  margin-top: 1.25rem;
  max-width: 60ch;
  font-size: 1.125rem;
}
.page-hero--center .page-hero__lede { margin-inline: auto; }

.page-hero :global(.eyebrow) { color: var(--accent-400); }

/*
 * Dwie kolumny robimy tylko wtedy, gdy zdjęcie faktycznie jest. Bez niego
 * `.page-hero__inner` zostaje zwykłym blokiem, więc strony bez obrazka
 * renderują się co do piksela tak jak dotąd.
 *
 * Klasa siedzi na tym samym elemencie, którego dotyczy, a nie na sekcji wyżej.
 * Selektor potomka działał w każdej przeglądarce, którą sprawdziłem, ale gdy
 * przestanie pasować - obojętne, przez co - zdjęcie ląduje pod tekstem, dosunięte
 * do prawej, i blok powitalny wygląda na zepsuty. Selektor jednoelementowy nie
 * ma jak nie zadziałać.
 */
.page-hero__inner--with-photo {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
}
@media (max-width: 980px) {
  .page-hero__inner--with-photo { grid-template-columns: 1fr; }
}

/*
 * Obok zdjęcia nagłówek dostaje niecałe dwie trzecie szerokości, więc przy
 * dotychczasowym stopniu pisma dłuższe tytuły łamały się na cztery wersy
 * i rozpychały blok. Mniejszy stopień mieści je w dwóch albo trzech. Strony
 * bez zdjęcia zostają przy starym rozmiarze - tam nic nie zabiera miejsca.
 */
.page-hero__inner--with-photo .page-hero__title {
  font-size: clamp(2rem, 3.4vw, 3.125rem);
}
</style>
