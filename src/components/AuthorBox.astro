---
import Icon from './Icon.astro';
import type { TeamMember } from '../data/team';
import { authorPath } from '../lib/blog';

interface Props {
  author: TeamMember;
  /** Pokazuj link do archiwum artykułów autora. */
  showArchiveLink?: boolean;
  /** Liczba artykułów autora - używana w etykiecie linku do archiwum. */
  postCount?: number;
}

const { author, showArchiveLink = true, postCount } = Astro.props;
// Archiwum powstaje tylko dla osób z artykułami - przy zerze nie linkujemy w pustkę.
const hasArchive = showArchiveLink && postCount !== 0;
const archiveLabel = postCount
  ? `Zobacz wszystkie artykuły autora (${postCount})`
  : 'Zobacz wszystkie artykuły autora';
---
<aside class="article-author-box" aria-label={`O autorze: ${author.name}`}>
  {author.photo ? (
    <picture class="article-author-box__photo">
      {author.photoWebp && <source srcset={author.photoWebp} type="image/webp" />}
      <img src={author.photo} alt={`${author.name} - ${author.jobTitle}`} width="88" height="88" loading="lazy" decoding="async" />
    </picture>
  ) : (
    <div class="article-author-box__avatar" aria-hidden="true">{author.initials}</div>
  )}
  <div class="article-author-box__body">
    <span class="article-author-box__role">O autorze</span>
    <h3>{author.name} - {author.jobTitle}</h3>
    <p>{author.bio}</p>
    {author.email && (
      <p>Bezpośredni kontakt: <a href={`mailto:${author.email}`}>{author.email}</a>.</p>
    )}
    <div class="article-author-box__links">
      {hasArchive && (
        <a href={authorPath(author.id)} class="btn btn--ghost btn--sm">
          <Icon name="file" size={14}/>
          <span>{archiveLabel}</span>
        </a>
      )}
      {author.linkedin && (
        <a href={author.linkedin} rel="noopener" target="_blank" class="btn btn--ghost btn--sm">
          <Icon name="linkedin" size={14}/>
          <span>LinkedIn</span>
        </a>
      )}
    </div>
  </div>
</aside>

<style>
.article-author-box {
  margin-top: 3rem;
  display: grid;
  grid-template-columns: 88px 1fr;
  gap: 1.25rem;
  align-items: start;
  background: linear-gradient(160deg, var(--accent-50), var(--white));
  border: 1px solid var(--accent-200);
  border-radius: var(--radius-xl);
  padding: 1.5rem 1.75rem;
}
.article-author-box__avatar {
  width: 88px; height: 88px;
  border-radius: var(--radius-2xl);
  background: linear-gradient(135deg, var(--ink-800), var(--ink-950));
  color: var(--accent-400);
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1.75rem;
  display: grid; place-items: center;
}
.article-author-box__photo { display: block; }
.article-author-box__photo img {
  width: 88px; height: 88px;
  border-radius: var(--radius-2xl);
  object-fit: cover;
}
.article-author-box__role {
  display: inline-block;
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent-700);
  margin-bottom: 0.375rem;
}
/* Box bywa renderowany wewnątrz .prose, gdzie h3 ma margin-top: 2.5rem - zerujemy go. */
.article-author-box h3 {
  font-size: 1.125rem;
  margin-top: 0;
  margin-bottom: 0.5rem;
}
.article-author-box p {
  font-size: 0.9375rem;
  line-height: 1.55;
  color: var(--text);
  margin-top: 0;
  margin-bottom: 0.5rem;
}
.article-author-box p:last-of-type { margin-bottom: 0; }
.article-author-box a { color: var(--accent-700); }
.article-author-box__links { margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
@media (max-width: 600px) {
  /* minmax(0, 1fr): przy zwykłym `1fr` kolumna rozciągała się do szerokości
     najdłuższego przycisku i wypychała treść boxu poza ekran. */
  .article-author-box {
    grid-template-columns: minmax(0, 1fr);
    text-align: center;
    padding: 1.25rem;
  }
  .article-author-box__avatar, .article-author-box__photo img { margin: 0 auto; }
  /* Przyciski jeden pod drugim - w rzędzie dłuższa etykieta łamała się na dwie linie. */
  .article-author-box__links { flex-direction: column; align-items: stretch; }
}
</style>
