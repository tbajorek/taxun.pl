---
/**
 * Ładuje reCAPTCHA v3 - ale tylko wtedy, gdy klucz publiczny jest ustawiony.
 * Bez klucza strona nie odwołuje się do Google, a formularz działa bez zmian
 * (serwer również pomija wtedy weryfikację tokenu).
 *
 * Użycie na stronie z formularzem - skrypt musi trafić do sekcji <head>:
 *
 *   <RecaptchaScript slot="head" />
 */
const siteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY as string | undefined;
---
{siteKey && <script async src={`https://www.google.com/recaptcha/api.js?render=${siteKey}`}></script>}
