---
/*
 * Zdjęcie w bloku powitalnym - jedno dla strony głównej i dla podstron, żeby
 * ramka, warianty plików i moment pobierania nie rozjeżdżały się między nimi.
 */
import { getImage } from 'astro:assets';
import type { SiteImage } from '../data/images';

interface Props {
  photo: SiteImage;
}
const { photo } = Astro.props;

/** Poniżej tej szerokości ramka jest schowana i zdjęcie ma się nie pobierać. */
const DESKTOP = '(min-width: 981px)';

/**
 * Najwyższa dopuszczalna wysokość ramki. Ta sama liczba rządzi jej szerokością
 * w CSS (idzie tam przez `--photo-max-h`) i podpowiedzią `sizes`, więc nie mają
 * jak się rozjechać - a rozjechane znaczy tyle, że przeglądarka pobiera wariant
 * dobrany pod inną szerokość, niż zdjęcie faktycznie zajmie.
 */
const MAX_HEIGHT = 440;

/** Kolumna ze zdjęciem przy `--container-max` ma 499 px i szersza nie będzie. */
const MAX_WIDTH = 500;

const ratio = photo.file.width / photo.file.height;

/**
 * Szerokość, w jakiej ramka stanie na desktopie: cała kolumna, a przy wysokim
 * kadrze tyle, ile zostaje z granicy wysokości. Drugi człon `min()` jest dla
 * węższych okien, gdzie kolumna schodzi do około 40% szerokości. Pionowy kadr
 * dostawał tu dotąd sztywne 500 px i przez to pobierał wariant 1000 px na
 * ramkę szerokości 293 px.
 */
const SIZES = `min(${Math.round(Math.min(MAX_WIDTH, MAX_HEIGHT * ratio))}px, 40vw)`;

/*
 * Przezroczysty piksel dla przeglądarki, w której żaden `<source>` nie pasuje -
 * czyli na telefonie. Waży 70 bajtów i siedzi w dokumencie, więc nie jest
 * żądaniem.
 */
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

const WIDTHS = [500, 750, 1000];

/*
 * Warianty składamy sami, bo `<Picture>` nie przepuszcza `media` do `<source>`.
 * Kolejność ma znaczenie: przeglądarka bierze pierwszy pasujący typ, więc AVIF
 * musi stać przed WebP, a WebP przed JPEG-iem.
 */
const sources = await Promise.all(
  (['avif', 'webp', 'jpeg'] as const).map(async (format) => {
    const variants = await Promise.all(
      WIDTHS.filter((width) => width <= photo.file.width).map(async (width) => {
        const built = await getImage({ src: photo.file, format, width });
        return `${built.src} ${width}w`;
      }),
    );
    return { type: `image/${format}`, srcset: variants.join(', ') };
  }),
);
---
{/*
  Ramka bierze proporcję z samego pliku, więc kadru nie przycinamy i każde
  kolejne zdjęcie wstawione w to miejsce trafia tu takie, jakie jest. Proporcja
  jest ustawiona z góry, więc układ nie skacze podczas ładowania.
*/}
<figure
  class="hero-photo"
  style={`--photo-ratio: ${photo.file.width} / ${photo.file.height}; --photo-max-h: ${MAX_HEIGHT}px`}
>
  {/*
    `loading="eager"` i wysoki priorytet, bo zdjęcie leży nad zgięciem i na
    desktopie bywa największym elementem treści. Przy `lazy` przeglądarka
    odkrywała je dopiero po pierwszym wyliczeniu układu i przez tę chwilę
    w ramce stał opis alternatywny - widać to było przy każdym odświeżeniu.
    Teraz zdjęcie znajduje skaner wstępnego wczytywania, jeszcze w trakcie
    parsowania HTML-a, i pobieranie startuje razem z dokumentem.

    `media` na źródłach pilnuje, żeby to nie kosztowało telefonu ani bajta:
    poniżej 981 px ramka jest schowana przez `display: none`, żaden `<source>`
    nie pasuje i zostaje przezroczysty piksel w `src`. Astro tego nie ustawi -
    `<Picture>` nie przyjmuje `media` - więc adresy składamy `getImage()`
    i piszemy `<picture>` wprost.
  */}
  <picture>
    {sources.map((source) => (
      <source type={source.type} srcset={source.srcset} sizes={SIZES} media={DESKTOP} />
    ))}
    <img
      src={BLANK}
      alt={photo.alt}
      width={photo.file.width}
      height={photo.file.height}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-photo__img"
    />
  </picture>
</figure>

<style>
/*
 * Zdjęcie wypełnia swoją kolumnę. Wcześniej stało tu sztywne 420 px, dobrane
 * pod kadr pionowy - kadr poziomy wychodził przy nim mały i wyglądał jak
 * doklejony obok tekstu, zamiast robić za drugą połowę bloku powitalnego.
 *
 * Drugi człon `min()` to w praktyce granica wysokości: przy ustalonej proporcji
 * `--photo-max-h * proporcja` wychodzi dokładnie na tyle wysokości. Zwężamy,
 * a nie ucinamy przez `max-height` - `max-height` przy ustalonej proporcji
 * przyciął zdjęcie zamiast je zmniejszyć. Granica wiąże tylko kadry pionowe,
 * bo poziome nie dochodzą do niej nawet na pełnej kolumnie.
 *
 * Zanim zdjęcie się namaluje, w tym miejscu nie ma nic. Stała tu wcześniej
 * ramka - obwódka, cień i tło w materiale kart - i przez tę chwilę widać było
 * pustą, obrysowaną skrzynkę, a w niej opis alternatywny. Zdjęcie nad zgięciem
 * ładuje się na tyle szybko, że ta ramka zdążyła tylko mrugnąć, i tak to
 * wyglądało. Proporcja zostaje, więc miejsce jest zarezerwowane i układ nie
 * skacze - po prostu do czasu pobrania nic go nie zajmuje.
 */
.hero-photo {
  margin: 0 0 0 auto;
  width: min(100%, calc(var(--photo-max-h, 440px) * (var(--photo-ratio, 4 / 5))));
  aspect-ratio: var(--photo-ratio, 4 / 5);
  border-radius: var(--radius-2xl);
  overflow: hidden;
}
/*
 * `color: transparent` gasi opis alternatywny. Przeglądarka maluje go kolorem
 * tekstu elementu, więc póki zdjęcia nie ma, w ramce stał biały akapit na
 * ciemnym tle - mrugnięcie na jedno przemalowanie. Atrybut `alt` zostaje na
 * miejscu, bo jest dla czytników ekranu i wyszukiwarek, a nie do oglądania;
 * `alt=""` załatwiłoby migotanie kosztem obu tych rzeczy.
 */
.hero-photo__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  color: transparent;
}

/*
 * Na telefonie zdjęcie odpada. Blok powitalny ma tam zmieścić nagłówek
 * i przyciski bez przewijania, a zdjęcie zepchnęłoby je poniżej zgięcia.
 */
@media (max-width: 980px) {
  .hero-photo { display: none; }
}
</style>
