---
import Icon from './Icon.astro';
---
<section class="home-hero">
  <div class="home-hero__bg" aria-hidden="true">
    <div class="home-hero__grid"></div>
    <div class="home-hero__glow home-hero__glow--1"></div>
    <div class="home-hero__glow home-hero__glow--2"></div>
  </div>
  <div class="container home-hero__inner">
    <div class="home-hero__content">
      <h1 class="home-hero__title">
        Biuro rachunkowe online <span class="home-hero__accent">dla JDG i&nbsp;spółek</span>
      </h1>
      <p class="home-hero__kicker">Skup się na swoim biznesie - resztą zajmiemy się my.</p>
      <p class="home-hero__lede">
        Pełna księgowość, kadry i płace dla jednoosobowych działalności i&nbsp;spółek
        w całej Polsce. KSeF, OCR i portal klienta w cenie. Ryczałt od&nbsp;199&nbsp;zł, KPiR od&nbsp;249&nbsp;zł,
        pełna księgowość spółek od&nbsp;999&nbsp;zł - bez ukrytych kosztów.
      </p>
      <p class="home-hero__founder-note">
        <a href="/o-nas">
          <Icon name="sparkle" size={14}/>
          <span>Poznaj nas →</span>
        </a>
      </p>
      <div class="home-hero__actions">
        <a href="/wycena" class="btn btn--accent btn--lg">
          <span>Otrzymaj bezpłatną wycenę</span>
          <Icon name="arrow-right" size={18}/>
        </a>
        <a href="/cennik" class="btn btn--ghost-light btn--lg">
          <Icon name="tag" size={18}/>
          <span>Zobacz cennik</span>
        </a>
      </div>
      <ul class="home-hero__trust">
        <li><Icon name="check-circle" size={16}/> KSeF, OCR i ZUS w cenie</li>
        <li><Icon name="check-circle" size={16}/> Szybki kontakt</li>
        <li><Icon name="check-circle" size={16}/> Bez ukrytych opłat</li>
      </ul>
    </div>

    <div class="home-hero__visual" aria-hidden="true">
      <div class="hero-card hero-card--main">
        <div class="hero-card__head">
          <div class="hero-card__chip">
            <span class="hero-card__bullet"></span>
            Twoje rozliczenia
          </div>
          <span class="hero-card__date">maj 2026</span>
        </div>
        <div class="hero-card__metric">
          <div class="hero-card__label">Wynik miesiąca</div>
          <div class="hero-card__value">+42 380 <span>PLN</span></div>
          <div class="hero-card__trend">
            <Icon name="trending-up" size={14}/>
            <span>+12,4% vs. poprzedni miesiąc</span>
          </div>
        </div>
        <div class="hero-card__sparkline" aria-hidden="true">
          <svg viewBox="0 0 220 60" preserveAspectRatio="none">
            <defs>
              <linearGradient id="sparkFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#10B981" stop-opacity="0.35"/>
                <stop offset="100%" stop-color="#10B981" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <path d="M0,42 L25,38 L50,44 L75,30 L100,34 L125,22 L150,26 L175,14 L200,18 L220,8 L220,60 L0,60 Z" fill="url(#sparkFill)"/>
            <path d="M0,42 L25,38 L50,44 L75,30 L100,34 L125,22 L150,26 L175,14 L200,18 L220,8" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <ul class="hero-card__items">
          <li><span>JPK_V7</span><strong>wysłane</strong></li>
          <li><span>ZUS DRA</span><strong>opłacone</strong></li>
          <li><span>PIT-5L</span><strong>w toku</strong></li>
        </ul>
      </div>
      <div class="hero-chip hero-chip--1">
        <Icon name="shield" size={16}/>
        <span>Pełne bezpieczeństwo</span>
      </div>
      <div class="hero-chip hero-chip--2">
        <Icon name="zap" size={16}/>
        <span>Wygodny dostęp do danych</span>
      </div>
      <div class="hero-chip hero-chip--3">
        <Icon name="headset" size={16}/>
        <span>Dedykowany opiekun kadrowo - księgowy</span>
      </div>
    </div>
  </div>
</section>

<style>
.home-hero {
  position: relative;
  background: linear-gradient(180deg, var(--ink-950) 0%, var(--ink-900) 100%);
  color: var(--white);
  padding: clamp(4rem, 9vw, 7rem) 0 clamp(5rem, 9vw, 8rem);
  overflow: hidden;
  isolation: isolate;
}

.home-hero__bg { position: absolute; inset: 0; z-index: -1; }
.home-hero__grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 80%);
}
.home-hero__glow {
  position: absolute;
  width: 600px; height: 600px;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.45;
}
.home-hero__glow--1 {
  background: radial-gradient(circle, #10B981, transparent 60%);
  top: -200px; right: -120px;
}
.home-hero__glow--2 {
  background: radial-gradient(circle, #1B3060, transparent 60%);
  bottom: -250px; left: -120px;
  opacity: 0.6;
}

.home-hero__inner {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
}

.home-hero__content { max-width: 640px; }

.home-hero__title {
  font-size: clamp(2.5rem, 6vw, 4.25rem);
  line-height: 1.05;
  color: var(--white);
  letter-spacing: -0.035em;
  font-weight: 800;
}
.home-hero__kicker {
  margin-top: 1rem;
  font-size: clamp(1.125rem, 2vw, 1.375rem);
  font-weight: 500;
  color: rgba(226,232,240,0.9);
  letter-spacing: -0.015em;
}
.home-hero__founder-note {
  margin-top: 1.5rem;
}
.home-hero__founder-note a {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.4rem 0.75rem;
  border-radius: var(--radius-full);
  background: rgba(16,185,129,0.12);
  border: 1px solid rgba(16,185,129,0.28);
  color: var(--accent-400);
  font-size: 0.8125rem;
  font-weight: 600;
  transition: background var(--transition-fast);
}
.home-hero__founder-note a:hover { background: rgba(16,185,129,0.2); }
.home-hero__founder-note svg { color: var(--accent-400); }
.home-hero__accent {
  background: linear-gradient(120deg, #34D399 0%, #10B981 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.home-hero__lede {
  margin-top: 1.5rem;
  font-size: 1.125rem;
  line-height: 1.65;
  color: rgba(226,232,240,0.85);
  max-width: 56ch;
}
.home-hero__actions {
  margin-top: 2rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}
.home-hero__trust {
  margin-top: 2rem;
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.5rem;
  font-size: 0.875rem;
  color: rgba(226,232,240,0.78);
}
.home-hero__trust li { display: inline-flex; align-items: center; gap: 0.4rem; }
.home-hero__trust svg { color: var(--accent-400); }

/* Hero visual */
.home-hero__visual {
  position: relative;
  min-height: 460px;
}
.hero-card {
  background: linear-gradient(160deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
  backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-2xl);
  padding: 1.75rem;
  box-shadow: var(--shadow-xl);
  color: var(--white);
}
.hero-card--main {
  width: 100%;
  max-width: 420px;
  margin-left: auto;
  position: relative;
  animation: floatY 6s ease-in-out infinite;
}
@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}
.hero-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8125rem;
}
.hero-card__chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.25rem 0.625rem;
  border-radius: var(--radius-full);
  background: rgba(16,185,129,0.16);
  color: var(--accent-400);
  font-weight: 600;
}
.hero-card__bullet { width: 6px; height: 6px; border-radius: 50%; background: var(--accent-400); }
.hero-card__date { color: rgba(255,255,255,0.55); font-variant-numeric: tabular-nums; }
.hero-card__metric { margin-top: 1.25rem; }
.hero-card__label {
  font-size: 0.8125rem;
  color: rgba(255,255,255,0.6);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}
.hero-card__value {
  font-family: var(--font-display);
  font-size: 2.25rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  margin-top: 0.25rem;
}
.hero-card__value span {
  font-size: 1rem;
  color: rgba(255,255,255,0.55);
  font-weight: 600;
  margin-left: 0.25rem;
}
.hero-card__trend {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  color: var(--accent-400);
  font-size: 0.8125rem;
  font-weight: 600;
  margin-top: 0.375rem;
}
.hero-card__sparkline {
  margin: 1.25rem -0.25rem 0;
  height: 60px;
}
.hero-card__sparkline svg { width: 100%; height: 100%; }
.hero-card__items {
  list-style: none;
  margin-top: 1.25rem;
  padding-top: 1rem;
  border-top: 1px solid rgba(255,255,255,0.08);
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.hero-card__items li {
  display: flex;
  justify-content: space-between;
  font-size: 0.875rem;
}
.hero-card__items span { color: rgba(255,255,255,0.6); }
.hero-card__items strong {
  font-weight: 600;
  color: var(--accent-400);
}
.hero-card__items li:last-child strong { color: #F59E0B; }

.hero-chip {
  position: absolute;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.625rem 0.875rem;
  background: var(--white);
  color: var(--ink-900);
  border-radius: var(--radius-full);
  font-size: 0.8125rem;
  font-weight: 600;
  box-shadow: var(--shadow-lg);
}
.hero-chip svg { color: var(--accent-600); }
.hero-chip--1 { top: 8%; left: -4%; animation: floatY 7s ease-in-out infinite 0.4s; }
.hero-chip--2 { top: 38%; right: -4%; animation: floatY 5.5s ease-in-out infinite 1s; }
.hero-chip--3 { bottom: 4%; left: 4%; animation: floatY 6.5s ease-in-out infinite 0.7s; }

@media (max-width: 980px) {
  .home-hero__inner { grid-template-columns: 1fr; }
  .home-hero__visual { display: none; }
}
</style>
