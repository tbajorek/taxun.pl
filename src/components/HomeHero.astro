---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { heroPhoto, heroPhotoAlt } from '../data/hero-photo';

/*
 * Chipy powtarzają obietnice z listy pod przyciskami, więc dla czytnika ekranu
 * są ozdobą - stąd `aria-hidden` na całej liście, a nie na każdym z osobna.
 */
const chips = [
  { icon: 'shield', label: 'Pełne bezpieczeństwo' },
  { icon: 'zap', label: 'Wygodny dostęp do danych' },
  { icon: 'headset', label: 'Dedykowany opiekun kadrowo - księgowy' },
];
---
<section class="home-hero">
  <div class="home-hero__bg" aria-hidden="true">
    <div class="home-hero__grid"></div>
    <div class="home-hero__glow home-hero__glow--1"></div>
    <div class="home-hero__glow home-hero__glow--2"></div>
  </div>
  <div class="container home-hero__inner">
    <div class="home-hero__content">
      <h1 class="home-hero__title">
        Biuro rachunkowe online <span class="home-hero__accent">dla JDG i&nbsp;spółek</span>
      </h1>
      <p class="home-hero__kicker">Skup się na swoim biznesie - resztą zajmiemy się my.</p>
      <p class="home-hero__lede">
        Pełna księgowość, kadry i płace dla jednoosobowych działalności i&nbsp;spółek
        w całej Polsce. KSeF, OCR i portal klienta w cenie. Ryczałt od&nbsp;199&nbsp;zł, KPiR od&nbsp;249&nbsp;zł,
        pełna księgowość spółek od&nbsp;999&nbsp;zł - bez ukrytych kosztów.
      </p>
      <p class="home-hero__founder-note">
        <a href="/o-nas">
          <Icon name="sparkle" size={14}/>
          <span>Poznaj nas →</span>
        </a>
      </p>
      <div class="home-hero__actions">
        <a href="/wycena" class="btn btn--accent btn--lg">
          <span>Otrzymaj bezpłatną wycenę</span>
          <Icon name="arrow-right" size={18}/>
        </a>
        <a href="/cennik" class="btn btn--ghost-light btn--lg">
          <Icon name="tag" size={18}/>
          <span>Zobacz cennik</span>
        </a>
      </div>
      <ul class="home-hero__trust">
        <li><Icon name="check-circle" size={16}/> KSeF, OCR i ZUS w cenie</li>
        <li><Icon name="check-circle" size={16}/> Szybki kontakt</li>
        <li><Icon name="check-circle" size={16}/> Bez ukrytych opłat</li>
      </ul>
    </div>

    {heroPhoto ? (
      <div class="home-hero__visual home-hero__visual--photo">
        <figure class="hero-photo">
          {/*
            `loading="lazy"` zamiast `eager`: poniżej 981 px cała kolumna jest
            schowana przez `display: none`, więc leniwe zdjęcie nigdy nie
            przetnie się z widokiem i telefon go w ogóle nie pobiera. Na
            desktopie leży nad zgięciem, więc pobieranie i tak startuje przy
            pierwszym wyliczeniu układu.
          */}
          <Picture
            src={heroPhoto}
            formats={['avif', 'webp']}
            widths={[420, 560, 840]}
            sizes="min(420px, 40vw)"
            alt={heroPhotoAlt}
            loading="lazy"
            decoding="async"
            class="hero-photo__img"
          />
        </figure>
        <ul class="hero-chips" aria-hidden="true">
          {chips.map((chip) => (
            <li class="hero-chip">
              <Icon name={chip.icon} size={16}/>
              <span>{chip.label}</span>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      /*
        Wariant zapasowy na czas, zanim w `src/assets/hero/` znajdzie się
        zdjęcie. Panel pokazuje wyłącznie to, co faktycznie robimy - statusy
        deklaracji i moduły w cenie. Nie ma tu kwot ani wykresu wyniku: liczba
        wzięta z powietrza w roli dowodu to slogan, a nie deklaracja
        weryfikowalna.
      */
      <div class="home-hero__visual home-hero__visual--card" aria-hidden="true">
        <div class="hero-card">
          <div class="hero-card__head">
            <span class="hero-card__chip">
              <span class="hero-card__bullet"></span>
              Twoje rozliczenia
            </span>
          </div>
          <ul class="hero-card__items">
            <li><span>JPK_V7</span><strong>wysłane</strong></li>
            <li><span>ZUS DRA</span><strong>opłacone</strong></li>
            <li><span>PIT-5L</span><strong class="is-pending">w toku</strong></li>
          </ul>
          <ul class="hero-card__chips">
            {chips.map((chip) => (
              <li>
                <Icon name={chip.icon} size={15}/>
                <span>{chip.label}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}
  </div>
</section>

<style>
.home-hero {
  position: relative;
  background: linear-gradient(180deg, var(--ink-950) 0%, var(--ink-900) 100%);
  color: var(--white);
  padding: clamp(4rem, 9vw, 7rem) 0 clamp(5rem, 9vw, 8rem);
  overflow: hidden;
  isolation: isolate;
}

.home-hero__bg { position: absolute; inset: 0; z-index: -1; }
.home-hero__grid {
  position: absolute; inset: 0;
  background-image:
    linear-gradient(to right, rgba(255,255,255,0.04) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255,255,255,0.04) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 80%);
}
.home-hero__glow {
  position: absolute;
  width: 600px; height: 600px;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.45;
}
.home-hero__glow--1 {
  background: radial-gradient(circle, #10B981, transparent 60%);
  top: -200px; right: -120px;
}
.home-hero__glow--2 {
  background: radial-gradient(circle, #1B3060, transparent 60%);
  bottom: -250px; left: -120px;
  opacity: 0.6;
}

.home-hero__inner {
  display: grid;
  grid-template-columns: 1.15fr 1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
}

.home-hero__content { max-width: 640px; }

.home-hero__title {
  font-size: clamp(2.5rem, 6vw, 4.25rem);
  line-height: 1.05;
  color: var(--white);
  letter-spacing: -0.035em;
  font-weight: 800;
}
.home-hero__kicker {
  margin-top: 1rem;
  font-size: clamp(1.125rem, 2vw, 1.375rem);
  font-weight: 500;
  color: rgba(226,232,240,0.9);
  letter-spacing: -0.015em;
}
.home-hero__founder-note {
  margin-top: 1.5rem;
}
.home-hero__founder-note a {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.4rem 0.75rem;
  border-radius: var(--radius-full);
  background: rgba(16,185,129,0.12);
  border: 1px solid rgba(16,185,129,0.28);
  color: var(--accent-400);
  font-size: 0.8125rem;
  font-weight: 600;
  transition: background var(--transition-fast);
}
.home-hero__founder-note a:hover { background: rgba(16,185,129,0.2); }
.home-hero__founder-note svg { color: var(--accent-400); }
.home-hero__accent {
  background: linear-gradient(120deg, #34D399 0%, #10B981 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.home-hero__lede {
  margin-top: 1.5rem;
  font-size: 1.125rem;
  line-height: 1.65;
  color: rgba(226,232,240,0.85);
  max-width: 56ch;
}
.home-hero__actions {
  margin-top: 2rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}
.home-hero__trust {
  margin-top: 2rem;
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.5rem;
  font-size: 0.875rem;
  color: rgba(226,232,240,0.78);
}
.home-hero__trust li { display: inline-flex; align-items: center; gap: 0.4rem; }
.home-hero__trust svg { color: var(--accent-400); }

/* Wizual po prawej */
.home-hero__visual {
  position: relative;
}

/* Zdjęcie */
.hero-photo {
  position: relative;
  margin: 0 0 0 auto;
  width: 100%;
  max-width: 420px;
  aspect-ratio: 4 / 5;
  border-radius: var(--radius-2xl);
  border: 1px solid rgba(255,255,255,0.14);
  box-shadow: var(--shadow-xl);
  overflow: hidden;
  isolation: isolate;
}
.hero-photo__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
/*
 * Przyciemnienie dołu: chip leżący na jasnym fragmencie zdjęcia gubi kontrast,
 * a sam kadr ma się schodzić z granatowym tłem hero, a nie kończyć krawędzią.
 */
.hero-photo::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(6,17,42,0) 45%, rgba(6,17,42,0.55) 100%);
  pointer-events: none;
}

/*
 * Chipy przy zdjęciu leżą na kadrze - na zdjęciu nie ma tekstu, więc nic nie
 * zasłaniają. Wcześniej ta sama trójka leżała na panelu z liczbami i przykrywała
 * nagłówek karty oraz wiersz ze zmianą miesiąc do miesiąca.
 *
 * Odsunięcia w prawo trzymamy poniżej 1,25 rem: sekcja ma `overflow: hidden`,
 * a najmniejszy odstęp kontenera od krawędzi to 1,5 rem.
 */
.hero-chips {
  list-style: none;
  margin: 0;
  padding: 0;
}
.hero-chip {
  position: absolute;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.625rem 0.875rem;
  background: var(--white);
  color: var(--ink-900);
  border-radius: var(--radius-full);
  font-size: 0.8125rem;
  font-weight: 600;
  line-height: 1.2;
  box-shadow: var(--shadow-lg);
}
.hero-chip svg { color: var(--accent-600); flex-shrink: 0; }
.hero-chip:nth-child(1) {
  top: 7%;
  left: -1.5rem;
  animation: floatY 7s ease-in-out infinite 0.4s;
}
.hero-chip:nth-child(2) {
  top: 44%;
  right: -1.25rem;
  animation: floatY 5.5s ease-in-out infinite 1s;
}
.hero-chip:nth-child(3) {
  bottom: 6%;
  left: -1.5rem;
  max-width: 88%;
  animation: floatY 6.5s ease-in-out infinite 0.7s;
}

@keyframes floatY {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

/* Wariant zapasowy: panel ze statusem rozliczeń */
.hero-card {
  width: 100%;
  max-width: 420px;
  margin-left: auto;
  background: linear-gradient(160deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
  backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-2xl);
  padding: 1.75rem;
  box-shadow: var(--shadow-xl);
  color: var(--white);
  animation: floatY 6s ease-in-out infinite;
}
.hero-card__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8125rem;
}
.hero-card__chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.25rem 0.625rem;
  border-radius: var(--radius-full);
  background: rgba(16,185,129,0.16);
  color: var(--accent-400);
  font-weight: 600;
}
.hero-card__bullet { width: 6px; height: 6px; border-radius: 50%; background: var(--accent-400); }
.hero-card__items {
  list-style: none;
  margin-top: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}
.hero-card__items li {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  font-size: 0.9375rem;
}
.hero-card__items span { color: rgba(255,255,255,0.6); }
.hero-card__items strong {
  font-weight: 600;
  color: var(--accent-400);
}
.hero-card__items .is-pending { color: #F59E0B; }
/*
 * Chipy w wariancie zapasowym stoją w karcie, a nie na niej: karta jest węższa
 * niż kolumna tylko o kilkadziesiąt pikseli, więc każdy chip odsunięty na bok
 * i tak wracał na tekst.
 */
.hero-card__chips {
  list-style: none;
  margin-top: 1.25rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(255,255,255,0.08);
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.hero-card__chips li {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8125rem;
  font-weight: 600;
  color: rgba(226,232,240,0.9);
}
.hero-card__chips svg { color: var(--accent-400); flex-shrink: 0; }

@media (max-width: 980px) {
  .home-hero__inner { grid-template-columns: 1fr; }
  .home-hero__visual { display: none; }
}

/*
 * Unoszenie się kart to dekoracja, a nie treść - kto prosi system o mniej ruchu,
 * dostaje ten sam układ bez nieskończonej animacji.
 */
@media (prefers-reduced-motion: reduce) {
  .hero-card,
  .hero-chip {
    animation: none;
  }
}
</style>
