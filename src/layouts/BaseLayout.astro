---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LegalNotice from '../components/LegalNotice.astro';
import { legalUpdatedFor } from '../data/legal';
import CookieConsent from '../components/CookieConsent.astro';
import GoogleTag from '../components/GoogleTag.astro';
// Pomiar Core Web Vitals uruchamiany dopiero po zgodzie na analitykę
// (lib/consent-integrations.ts), dlatego własny komponent zamiast
// gotowego @vercel/speed-insights/astro, który ładował się bezwarunkowo.
import SpeedInsights from '../components/SpeedInsights.astro';
import { site } from '../data/site';
import { founder, personSchema } from '../data/team';
// Vite nadaje plikom nazwy z odciskiem treści, więc adresy do preloadu muszą
// pochodzić z importu, a nie być wpisane ręcznie.
import interFont from '../assets/fonts/inter-variable-latin.woff2';
import displayFont from '../assets/fonts/plus-jakarta-sans-variable-latin.woff2';


interface Crumb { label: string; href?: string }

/** Metadane artykułu - autor, daty, dział i tagi trafiają do znaczników Open Graph. */
interface ArticleMeta {
  /** Imię i nazwisko autora z konfiguracji zespołu (src/data/team.ts). */
  authorName: string;
  /** Adres archiwum artykułów autora - Open Graph oczekuje tu profilu, nie nazwiska. */
  authorUrl: string;
  publishedTime: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  /** Wymiary i typ obrazka Open Graph - podawane razem z własnym `ogImage`. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  breadcrumbs?: Crumb[];
  bodyClass?: string;
  /** Wypełniane tylko przez strony artykułów (ogType="article"). */
  article?: ArticleMeta;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.png',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageType = 'image/png',
  ogType = 'website',
  noindex = false,
  schema,
  breadcrumbs,
  bodyClass = '',
  article,
} = Astro.props;

const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
// Canonical without trailing slash (except root) - single canonical form across site
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath === '/' ? '/' : rawPath.replace(/\/$/, '');
const url = canonical ?? new URL(normalizedPath, site.url).toString();

const orgId = `${site.url}/#organization`;
const founderId = `${site.url}/#tomasz-bajorek`;
const websiteId = `${site.url}/#website`;

const organizationSchema = {
  '@type': ['Organization', 'ProfessionalService', 'AccountingService', 'LocalBusiness'],
  '@id': orgId,
  name: site.name,
  legalName: site.legalName,
  alternateName: 'Biuro rachunkowe Taxun',
  description: 'Nowoczesne biuro rachunkowe online z portalem klienta, KSeF i OCR w cenie. Księgowość, kadry i płace dla JDG i spółek.',
  url: site.url,
  logo: `${site.url}/logo-mark.png`,
  image: `${site.url}/og-image.png`,
  email: site.email,
  telephone: `+${site.phoneHref.replace(/^\+/, '')}`,
  founder: { '@id': founderId },
  founders: [{ '@id': founderId }],
  taxID: site.taxId.nip,
  vatID: site.taxId.vatId,
  identifier: [
    { '@type': 'PropertyValue', name: 'NIP', value: site.taxId.nip },
    { '@type': 'PropertyValue', name: 'REGON', value: site.taxId.regon },
  ],
  // Biuro pracuje w 100% online, a adres rejestrowy jest adresem prywatnym,
  // więc w danych strukturalnych podajemy tylko to, co publikujemy publicznie:
  // miasto i realny obszar obsługi. Bez ulicy, kodu i współrzędnych.
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.countryCode,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: site.hoursStructured.days,
    opens: site.hoursStructured.opens,
    closes: site.hoursStructured.closes,
  }],
  areaServed: [
    { '@type': 'Country', name: 'Polska' },
    { '@type': 'City', name: 'Kraków' },
  ],
  priceRange: site.priceRange,
  currenciesAccepted: 'PLN',
  paymentAccepted: 'Przelew bankowy, polecenie zapłaty',
  sameAs: [site.social.linkedin, site.social.facebook, site.social.instagram],
};

// Dane założyciela pochodzą z konfiguracji zespołu (src/data/team.ts).
const founderSchema = personSchema(founder, site.url, orgId);

const websiteSchema = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: site.url,
  name: site.name,
  description: 'Nowoczesne biuro rachunkowe online - KSeF, OCR i portal klienta w cenie.',
  publisher: { '@id': orgId },
  inLanguage: 'pl-PL',
};

/*
 * Google wymaga pola `item` w każdym elemencie ścieżki poza ostatnim, a element
 * bez niego unieważnia całą BreadcrumbList. Okruszki w rodzaju "Usługi" czy
 * "Branże" to nagłówki rozwijanego menu, nie strony, więc nie mają dokąd
 * prowadzić - w danych strukturalnych je pomijamy, w widocznej ścieżce zostają.
 * Pozycje numerujemy dopiero po odfiltrowaniu, bo muszą iść bez przerw.
 */
const schemaCrumbs = (breadcrumbs ?? []).filter(
  (c, i) => c.href || i === breadcrumbs!.length - 1,
);

const breadcrumbsList = schemaCrumbs.length ? {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: site.url },
    ...schemaCrumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: c.label,
      ...(c.href ? { item: new URL(c.href, site.url).toString() } : {}),
    })),
  ],
} : null;

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationSchema,
    founderSchema,
    websiteSchema,
    ...(breadcrumbsList ? [breadcrumbsList] : []),
    ...extraSchemas,
  ],
};

/**
 * Zastrzeżenie prawne dla stron ofertowych i branżowych.
 *
 * Wstawiamy je tutaj, a nie w każdej podstronie z osobna, bo treść jest wszędzie
 * ta sama, a lista stron rośnie z każdą nową branżą. O tym, czy ramka się
 * pokaże, decyduje wpis w `src/data/legal-updated.json` - strony bez informacji
 * (kontakt, o nas) go nie mają, a te z własnym zdaniem do dodania renderują
 * `<LegalNotice>` u siebie.
 */
const legalUpdated = legalUpdatedFor(Astro.url.pathname);
---
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light only" />
  <meta name="theme-color" content="#0A1A35" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  <link rel="canonical" href={url} />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={new URL(ogImage, site.url).toString()} />
  <meta property="og:image:width" content={String(ogImageWidth)} />
  <meta property="og:image:height" content={String(ogImageHeight)} />
  <meta property="og:image:type" content={ogImageType} />
  <meta property="og:locale" content="pl_PL" />
  {article && (
    <>
      <meta name="author" content={article.authorName} />
      <meta property="article:author" content={new URL(article.authorUrl, site.url).toString()} />
      <meta property="article:published_time" content={article.publishedTime} />
      {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
      {article.section && <meta property="article:section" content={article.section} />}
      {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    </>
  )}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, site.url).toString()} />

  {/*
    Geo tylko na poziomie regionu i miasta. Współrzędnych (geo.position, ICBM)
    nie podajemy - wskazywały punkt adresu rejestrowego, czyli adresu prywatnego.
  */}
  <meta name="geo.region" content="PL-MA" />
  <meta name="geo.placename" content={site.address.city} />

  {/*
    Ikony. Obie składa `npm run brand` ze znaku wyciętego z logo, więc pokazują
    dokładnie to samo co nagłówek serwisu. Wcześniej stał tu rysunek wektorowy
    znaku, przygotowany osobno i przez to trochę inny.

    Znika `mask-icon`: to przypięte karty w Safari, a te wymagają jednokolorowego
    SVG. Znaku nie da się do tego sprowadzić bez rysowania go drugi raz, czyli
    bez wrócenia do problemu, który ta zmiana rozwiązuje.
  */}
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  {/*
    Kroje hostujemy u siebie (definicje @font-face w src/styles/global.css)
    i preloadujemy oba.

    Największy element treści to blok powitalny, a jego malowanie kończy się
    dopiero po podmianie obu krojów - nagłówkowego i tekstowego. Zmierzone na
    dławionym łączu (1,6 Mb/s, procesor 4x wolniejszy), mediana z dziewięciu
    przebiegów:

      bez preloadów          FCP ~400 ms   LCP ~940 ms
      preload samej Jakarty  FCP ~504 ms   LCP ~1040 ms
      preload obu            FCP ~484 ms   LCP ~690 ms

    Preload jednego kroju wypada najgorzej: odsuwa drugi, więc podmiana i tak
    czeka na tego, którego nie preloadowaliśmy. Za ~80 ms wolniejsze pierwsze
    renderowanie kupujemy ~250 ms szybszy największy element - a Lighthouse waży
    LCP dwa i pół raza mocniej niż FCP.

    Warunkiem jest to, że nic innego nie zabiera pasma na starcie: dopóki
    gtag.js pobierał się w <head>, te same preloady kosztowały 576 ms FCP i nic
    nie dawały. Jeżeli kiedyś wróci tam coś dużego, ten pomiar trzeba powtórzyć.

    Same @font-face mają `font-display: swap` i metrycznie dopasowane kroje
    zastępcze, więc tekst jest widoczny od pierwszej klatki, a podmiana nie
    przesuwa układu (CLS zostaje 0). `crossorigin` jest wymagane także przy
    własnej domenie: fonty pobiera się zawsze w trybie CORS, a bez tego
    atrybutu przeglądarka pobrałaby plik drugi raz.
  */}
  <link rel="preload" as="font" type="font/woff2" href={interFont} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />

  <!-- Tag Google: Analytics 4 i Google Ads (Consent Mode v2) -->
  <GoogleTag />

  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="alternate" type="application/rss+xml" title={`${site.name} - Wiedza`} href="/wiedza/feed.xml" />

  <script type="application/ld+json" set:html={JSON.stringify(graph)} />

  <slot name="head" />
</head>
<body class={bodyClass}>
  <Header />
  <main id="main">
    <slot />
    {legalUpdated && (
      <section class="legal-notice-section">
        <div class="container"><LegalNotice updated={legalUpdated} /></div>
      </section>
    )}
  </main>
  <Footer />
  <CookieConsent />
  <SpeedInsights />

  <button id="to-top" class="to-top" aria-label="Wróć na górę">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

  <style>
    /* Ramka z zastrzeżeniem wstawiana przez układ - odstęp mniejszy niż przy
       zwykłej sekcji, bo to podpis pod treścią, a nie kolejny jej rozdział. */
    .legal-notice-section { padding: 0 0 clamp(2rem, 4vw, 3rem); }

    .to-top {
      position: fixed;
      bottom: 24px; right: 24px;
      width: 44px; height: 44px;
      border-radius: var(--radius-full);
      background: var(--ink-900);
      color: var(--white);
      box-shadow: var(--shadow-lg);
      display: grid;
      place-items: center;
      opacity: 0;
      pointer-events: none;
      transform: translateY(8px);
      transition: opacity var(--transition-base), transform var(--transition-base), background var(--transition-base);
      z-index: 30;
    }
    .to-top.is-visible { opacity: 1; pointer-events: auto; transform: translateY(0); }
    .to-top:hover { background: var(--accent-500); color: var(--ink-950); }
  </style>

  <script>
    // Reveal on scroll
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // Counters - animate from 0 up to the real (SSR-rendered) final value.
    // The element already contains the final number for SSR/crawlers; JS only
    // overrides it during the count-up animation.
    const counterIO = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as HTMLElement;
        const target = Number(el.dataset.count || 0);
        const suffix = el.dataset.suffix || '';
        const prefix = el.dataset.prefix || '';
        const duration = 1600;
        const start = performance.now();
        const step = (now: number) => {
          const p = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - p, 3);
          const value = Math.floor(target * eased);
          el.textContent = `${prefix}${value}${suffix}`;
          if (p < 1) requestAnimationFrame(step);
          else el.textContent = `${prefix}${target}${suffix}`;
        };
        requestAnimationFrame(step);
        counterIO.unobserve(el);
      }
    }, { threshold: 0.4 });
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => counterIO.observe(el));

    // Back to top
    const top = document.getElementById('to-top');
    const onScroll = () => top?.classList.toggle('is-visible', window.scrollY > 480);
    window.addEventListener('scroll', onScroll, { passive: true });
    top?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
  </script>

  {/*
    Jedyny doładowywany skrypt strony. Każdy `<script>` w komponencie to osobny
    punkt wejścia bundlera: osobne żądanie, a do tego wspólny kod (silnik zgód,
    analityka) wydzielany do plików, które przeglądarka odkrywa dopiero po
    sparsowaniu punktu wejścia - czyli druga runda w sieci. Baner zgód, pomiar
    i reguły konwersji startują więc stąd, z jednego miejsca.

    Skrypty, od których zależy widoczność treści (odsłanianie sekcji, nawigacja),
    zostają osobno i bez importów - Astro wstawia je wtedy wprost do dokumentu,
    więc działają bez czekania na sieć.
  */}
  <script>
    import { initCookieBanner } from '../lib/cookie-banner';
    import { bootstrapIntegrations } from '../lib/consent-integrations';
    import { initContactTracking } from '../lib/analytics-auto';
    import { initTrafficSource } from '../lib/traffic-source';

    // Baner zgód - importuje silnik (`lib/consent`), więc jest pierwszy.
    initCookieBanner();

    // Bootstrap integrations after consent engine is loaded
    bootstrapIntegrations();

    // Źródło wejścia zapamiętujemy przy każdym wczytaniu strony, żeby konwersja
    // wysłana z formularza wiedziała, od której podstrony zaczęła się wizyta.
    // Zdarzeń poza odsłoną i próbami kontaktu nie mierzymy.
    initTrafficSource();

    // Kliknięcia w numer telefonu - druga, obok formularzy, próba kontaktu.
    initContactTracking();
  </script>
</body>
</html>
