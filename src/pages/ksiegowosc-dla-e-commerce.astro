  { name: 'Obsługa procedury VAT OSS', price: `${ossFees.ossMonthly} zł`, unit: '/ mies.' },
  { name: 'Rejestracja do procedury IOSS', price: `${ossFees.iossSetup} zł`, unit: 'jednorazowo' },
  { name: 'Obsługa procedury IOSS', price: `${ossFees.iossMonthly} zł`, unit: '/ mies.' },
  { name: 'Rejestracja do VAT w innym kraju Unii Europejskiej', price: 'partner', unit: 'wskazujemy wyspecjalizowanego partnera' },
];

/**
 * Przykłady liczone, a nie przepisane. Wejściem są liczby, jakie klient zna o
 * własnym sklepie; dokumenty i stawka powstają z przelicznika i z tabel
 * cennikowych, więc zmiana ceny w pricing.ts przenosi się tutaj sama.
 *
 * Wszystkie trzy profile są czynnymi podatnikami VAT - w e-commerce to reguła,
 * bo albo przesądza o tym skala sprzedaży, albo asortyment.
 */
const perDocs = (count: number, per: number) => Math.ceil(count / per);

const buildExample = (e: {
  title: string;
  intro: string;
  tx: number;
  channels: number;
  lines: number;
  costDocs: number;
  oss: boolean;
}) => {
  const salesDocs = perDocs(e.tx, ecommerce.txPerDoc);
  const lineDocs = perDocs(e.lines, ecommerce.linesPerDoc);
  const totalDocs = salesDocs + lineDocs + e.costDocs;
  const table = tables.find((t) => t.id === 'ryczalt');
  const bucket = table?.buckets.find((b) => b.upTo !== null && b.upTo >= totalDocs);
  const base = typeof bucket?.withVat === 'number' ? bucket.withVat : null;
  const channelFee = Math.max(0, e.channels - ecommerce.freeChannels) * ecommerce.channelRate;
  const ossFee = e.oss ? ossFees.ossMonthly : 0;
  return {
    ...e,
    salesDocs,
    lineDocs,
    totalDocs,
    bucketRange: (bucket?.range ?? '').replace(/\s{2,}/g, ' '),
    base,
    channelFee,
    ossFee,
    total: base === null ? null : base + channelFee + ossFee,
  };
};

