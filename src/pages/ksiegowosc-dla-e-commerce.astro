import { currencyInvoices, ecommerce, hrMin, hrPricing, ossFees, startsFrom, surchargeFreeUntilDay, tables } from '../data/pricing';
import {
  DAC7_OD,
  DAC7_PROG_EUR,
  DAC7_PROG_TRANSAKCJE,
  DAC7_RAPORT_DO,
  IOSS_LIMIT_EUR,
  KASA_ECOMMERCE_WYJATKI,
  KASA_LIMIT_ROCZNY,
  KASA_WYSYLKA_WARUNKI,
  KASA_ZWOLNIENIA_DO,
  KSEF_NAJMNIEJSI_OD,
  KSEF_ODBIOR_OD,
  KSEF_WYSTAWIANIE_OD,
  OSS_DOKUMENTACJA_LATA,
  OSS_LIMIT,
  OSS_LIMIT_EUR,
  PIT_RATE_LINIOWY,
  RYCZALT_HANDEL,
  RYCZALT_LIMIT,
  RYCZALT_LIMIT_EUR,
  RYCZALT_POSREDNICTWO_DETAL,
  RYCZALT_POSREDNICTWO_HURT,
  VAT_WYLACZENIA_NA_ODLEGLOSC,
  VAT_WYLACZENIE_CZESCI_POJAZDY,
  VAT_ZWOLNIENIE_LIMIT,
} from '../lib/tax-constants';
import { num, pct, zl } from '../lib/format';
import { industriesLabel, site } from '../data/site';

const fmt = new Intl.NumberFormat('pl-PL');
const ryczalt = startsFrom('ryczalt');
const kpir = startsFrom('kpir');
const fk = startsFrom('fk');
const ryczaltVat = tables.find((t) => t.id === 'ryczalt')?.buckets[0].withVat ?? ryczalt;
const stawkaHandel = pct(RYCZALT_HANDEL);
const stawkaPosrednictwo = pct(RYCZALT_POSREDNICTWO_DETAL);
const stawkaHurt = pct(RYCZALT_POSREDNICTWO_HURT);
const stawkaLiniowa = pct(PIT_RATE_LINIOWY);
const limitVat = zl(VAT_ZWOLNIENIE_LIMIT);
const progOss = `${num(OSS_LIMIT_EUR)} euro`;
/** Najtańszy wariant obsługi kadrowej - umowa cywilnoprawna bez składek ZUS. */
const hrZlecenie = hrPricing.find((h) => h.id === 'zlecenie')?.price ?? hrMin;
const hrEtat = hrPricing.find((h) => h.id === 'uop')?.price ?? hrMin;

/**
 * Pozycje do katalogu ofert w danych strukturalnych, składane z tabel
 * cennikowych - dzięki temu znaczniki dla wyszukiwarek nie mogą rozjechać się
 * z cennikiem po zmianie stawek.
 *
 * W e-commerce prawie każdy klient jest czynnym podatnikiem VAT, albo przez
 * skalę sprzedaży, albo przez wyłączenia asortymentowe opisane niżej, więc
 * bierzemy kolumnę "z VAT". Wyjątkiem jest sam start sprzedaży, stąd jedna
 * pozycja ze stawką dla zwolnionych.
 */
const priceRow = (id: 'ryczalt' | 'kpir' | 'fk', upTo: number, vat: 'noVat' | 'withVat') => {
  const table = tables.find((t) => t.id === id);
  const bucket = table?.buckets.find((b) => b.upTo === upTo);
  const price = table?.hasVat ? bucket?.[vat] : bucket?.price;
  return {
    form: table?.shortName ?? '',
    vatLabel: table?.hasVat ? (vat === 'noVat' ? 'zwolniony z VAT' : 'czynny podatnik VAT') : '',
    docs: (bucket?.range ?? '').replace(/\s{2,}/g, ' '),
    price: typeof price === 'number' ? price : null,
  };
};

const priceRows = [
  priceRow('ryczalt', 10, 'noVat'),
  priceRow('ryczalt', 10, 'withVat'),
  priceRow('ryczalt', 30, 'withVat'),
  priceRow('kpir', 30, 'withVat'),
  priceRow('kpir', 70, 'withVat'),
  priceRow('fk', 30, 'noVat'),
];

/** Zasady przeliczania zestawień sprzedaży i wyciągów na dokumenty księgowe. */
