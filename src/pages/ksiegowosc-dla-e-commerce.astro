  { rule: `Każde rozpoczęte kolejne ${ecommerce.txPerDoc} transakcji w tym samym zestawieniu`, equals: 'kolejny dokument' },
  { rule: `Wyciąg bankowy albo raport z bramki płatniczej, do ${ecommerce.linesPerDoc} pozycji`, equals: '1 dokument' },
  { rule: `Każde rozpoczęte kolejne ${ecommerce.linesPerDoc} pozycji`, equals: 'kolejny dokument' },
];

/** Pozycje cennika dotyczące wyłącznie sprzedaży do konsumentów za granicą. */
