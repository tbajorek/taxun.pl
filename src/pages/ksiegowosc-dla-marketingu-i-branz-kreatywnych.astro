<style>
/* ── Hero ─────────────────────────────────────────────────────────────── */
.hero-badges {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.25rem;
  margin-top: 1.75rem;
}
.hero-badges li {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-on-dark);
}
.hero-badges :global(svg) { color: var(--accent-400); flex-shrink: 0; }

/* ── Wspólne elementy ─────────────────────────────────────────────────── */
.mkt-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 2rem;
  justify-content: center;
}
.mkt-note {
  display: flex;
  gap: 0.75rem;
  align-items: flex-start;
  margin-top: 1.75rem;
  padding: 1.125rem 1.375rem;
  background: var(--accent-50);
  border: 1px solid var(--accent-200);
  border-radius: var(--radius-lg);
  font-size: 0.9375rem;
  line-height: 1.65;
  color: var(--ink-900);
}
.mkt-note :global(svg) { color: var(--accent-700); flex-shrink: 0; margin-top: 4px; }
.mkt-note a { color: var(--accent-700); text-decoration: underline; text-underline-offset: 3px; }
.mkt-lede-center {
  margin-top: 1.75rem;
  text-align: center;
  max-width: 72ch;
  margin-inline: auto;
  font-size: 0.9375rem;
  color: var(--text-muted);
  line-height: 1.7;
}

/* ── Dla kogo ─────────────────────────────────────────────────────────── */
.mkt-segments {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.25rem;
}
@media (min-width: 980px) {
  /* Sześć kolumn pozwala ułożyć pięć kart bez pustego miejsca: trzy karty po
     dwie kolumny w pierwszym rzędzie, dwie po trzy kolumny w drugim. */
  .mkt-segments { grid-template-columns: repeat(6, 1fr); }
  .mkt-segments > * { grid-column: span 2; }
  .mkt-segments > :nth-child(4),
  .mkt-segments > :nth-child(5) { grid-column: span 3; }
}
.mkt-segment {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
  transition: transform var(--transition-base), box-shadow var(--transition-base);
}
.mkt-segment:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.mkt-segment__icon {
  width: 44px; height: 44px;
  border-radius: var(--radius-md);
  background: var(--accent-50);
  color: var(--accent-700);
  display: grid; place-items: center;
}
.mkt-segment h3 { font-size: 1.125rem; }
.mkt-segment > p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.55; }
.mkt-segment ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-top: auto;
  padding-top: 0.5rem;
}
.mkt-segment li {
  display: flex;
  gap: 0.5rem;
  align-items: flex-start;
  font-size: 0.875rem;
  color: var(--text);
}
.mkt-segment li :global(svg) { color: var(--accent-600); flex-shrink: 0; margin-top: 4px; }

/* ── Tabela stawek ryczałtu ───────────────────────────────────────────── */
.mkt-rates {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.mkt-rates__head,
.mkt-rates__row {
  display: grid;
  grid-template-columns: 1.6fr 1fr auto;
  gap: 1rem;
  align-items: center;
  padding: 1.125rem 1.5rem;
}
.mkt-rates__head {
  background: var(--ink-50);
  border-bottom: 1px solid var(--border);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-subtle);
}
.mkt-rates__row { border-bottom: 1px solid var(--border-subtle); }
.mkt-rates__row:last-child { border-bottom: none; }
.mkt-rates__row--featured { background: var(--accent-50); }
.mkt-rates__service { font-size: 0.9375rem; color: var(--text-strong); font-weight: 600; line-height: 1.45; }
.mkt-rates__code { font-size: 0.875rem; color: var(--text-subtle); }
.mkt-rates__value { text-align: right; }
.mkt-rates__value strong {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--accent-700);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
@media (max-width: 720px) {
  .mkt-rates__head { display: none; }
  .mkt-rates__row {
    grid-template-columns: 1fr auto;
    row-gap: 0.375rem;
  }
  /* Nazwa usługi zajmuje cały wiersz, a klasyfikacja i stawka stoją obok
     siebie - dzięki temu stawka nie odjeżdża pod spód, w oderwaniu od nazwy. */
  .mkt-rates__service { grid-column: 1 / -1; }
  .mkt-rates__code { grid-column: 1; }
  .mkt-rates__value { align-self: center; }
}

/* ── Wyróżniony blok ostrzegawczy ─────────────────────────────────────── */
.mkt-warning {
  display: flex;
  gap: 1.25rem;
  align-items: flex-start;
  margin-top: 1.75rem;
  padding: clamp(1.5rem, 3vw, 2rem);
  background: var(--white);
  border: 1px solid var(--accent-200);
  border-left: 4px solid var(--accent-500);
  border-radius: var(--radius-xl);
}
.mkt-warning__icon {
  flex-shrink: 0;
  width: 44px; height: 44px;
  border-radius: var(--radius-md);
  background: var(--accent-50);
  color: var(--accent-700);
  display: grid; place-items: center;
}
.mkt-warning h3 { font-size: 1.25rem; margin-bottom: 0.625rem; }
.mkt-warning p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.7; }
.mkt-warning p + p { margin-top: 0.75rem; }
@media (max-width: 640px) {
  .mkt-warning { flex-direction: column; gap: 1rem; }
}

/* ── Panel wyjaśniający (ciemny) ──────────────────────────────────────── */
.mkt-approach {
  display: flex;
  gap: 1.25rem;
  align-items: flex-start;
  margin-top: 1.75rem;
  padding: clamp(1.5rem, 3vw, 2rem);
  background: var(--ink-900);
  border-radius: var(--radius-xl);
  color: var(--text-on-dark);
}
.mkt-approach__icon {
  flex-shrink: 0;
  width: 44px; height: 44px;
  border-radius: var(--radius-md);
  background: rgba(16,185,129,0.16);
  color: var(--accent-400);
  display: grid; place-items: center;
}
.mkt-approach--warn .mkt-approach__icon { background: rgba(245,158,11,0.16); color: var(--warning); }
.mkt-approach h3 { color: var(--white); font-size: 1.25rem; margin-bottom: 0.625rem; }
.mkt-approach p { font-size: 0.9375rem; color: var(--text-on-dark-muted); line-height: 1.7; }
.mkt-approach p + p { margin-top: 0.75rem; }
.mkt-approach a { color: var(--accent-400); text-decoration: underline; text-underline-offset: 3px; }
@media (max-width: 640px) {
  .mkt-approach { flex-direction: column; gap: 1rem; }
}

/* ── Formy opodatkowania ──────────────────────────────────────────────── */
.mkt-forms {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
