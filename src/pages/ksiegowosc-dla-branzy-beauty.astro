const stawkaHandel = pct(RYCZALT_HANDEL);
const vatObnizony = pct(VAT_RATE_OBNIZONA);
const vatPodstawowy = pct(VAT_RATE);
const limitVat = zl(VAT_ZWOLNIENIE_LIMIT);
