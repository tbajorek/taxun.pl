---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import CTA from '../../../../components/CTA.astro';
import BlogArchive from '../../../../components/BlogArchive.astro';
import {
  articleCount,
  categoryPath,
  collectCategories,
  collectTags,
  getPostAuthor,
  getPostsByCategory,
  getSortedPosts,
  POSTS_PER_PAGE,
  slugify,
} from '../../../../lib/blog';
import { personSchemaId } from '../../../../data/team';
import { site } from '../../../../data/site';

/**
 * Archiwum kategorii z paginacją. Filtrowanie odbywa się po stronie serwera,
 * więc lista pozostaje poprawna niezależnie od liczby artykułów.
 */
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getSortedPosts();
  const categories = collectCategories(posts);
  return categories.flatMap((category) => {
    const inCategory = getPostsByCategory(posts, category.slug);
    return paginate(inCategory, {
      params: { category: category.slug },
      props: { categoryName: category.name },
      pageSize: POSTS_PER_PAGE,
    });
  });
};

interface Props { page: any; categoryName: string }
const { page, categoryName } = Astro.props;

const allPosts = await getSortedPosts();
const categories = collectCategories(allPosts);
const activeCategory = slugify(categoryName);
/*
 * Tagi tylko z tej kategorii. Globalna chmura tagów w archiwum kategorii myli:
 * kusi tagiem, który w tej kategorii nie ma ani jednego artykułu.
 */
const popularTags = collectTags(getPostsByCategory(allPosts, activeCategory));
const hrefFor = (p: number) => categoryPath(categoryName, p);

const breadcrumbs = [
  { label: 'Wiedza', href: '/wiedza' },
  { label: categoryName, ...(page.currentPage > 1 ? { href: categoryPath(categoryName) } : {}) },
  ...(page.currentPage > 1 ? [{ label: `Strona ${page.currentPage}` }] : []),
];

const total = page.total;
const collectionSchema = {
  '@type': 'CollectionPage',
  '@id': `${site.url}${categoryPath(categoryName)}#collection`,
  name: `${categoryName} - artykuły w bazie wiedzy Taxun`,
  url: `${site.url}${categoryPath(categoryName)}`,
  inLanguage: 'pl-PL',
  isPartOf: { '@id': `${site.url}/#website` },
  hasPart: page.data.map((p: (typeof allPosts)[number]) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    url: `${site.url}/wiedza/${p.id}`,
    datePublished: p.data.pubDate.toISOString(),
    dateModified: (p.data.updatedDate ?? p.data.pubDate).toISOString(),
    author: { '@id': personSchemaId(getPostAuthor(p), site.url) },
  })),
};

const title = page.currentPage > 1
  ? `${categoryName} - artykuły, strona ${page.currentPage} | Taxun`
  : `${categoryName} - artykuły | Taxun`;

/** Numer strony w opisie - bez niego kolejne strony listy mają opis identyczny z pierwszą. */
const pageSuffix = page.currentPage > 1 ? ` Strona ${page.currentPage} z ${page.lastPage}.` : '';
---
<BaseLayout
  title={title}
  description={`Artykuły z kategorii ${categoryName} w bazie wiedzy Taxun. Praktyczna wiedza podatkowa bez branżowego żargonu.${pageSuffix}`}
  schema={collectionSchema}
  breadcrumbs={breadcrumbs}
>
  {page.url.prev && <link slot="head" rel="prev" href={new URL(page.url.prev, site.url).toString()} />}
  {page.url.next && <link slot="head" rel="next" href={new URL(page.url.next, site.url).toString()} />}

  <PageHero
    eyebrow="Kategoria"
    title={categoryName}
    description={`${articleCount(total)} w tej kategorii.`}
    breadcrumbs={breadcrumbs}
  />

  <section class="section">
    <div class="container">
      <BlogArchive
        posts={page.data}
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        total={total}
        hrefFor={hrefFor}
        categories={categories}
        activeCategory={activeCategory}
        activeCategoryName={categoryName}
        popularTags={popularTags}
        emptyMessage={`Nie ma jeszcze artykułów w kategorii ${categoryName}.`}
      />
    </div>
  </section>

  <CTA
    variant="dark"
    title="Potrzebujesz indywidualnej odpowiedzi?"
    description="Każdy artykuł to ogólny przewodnik. Szczegóły zawsze zależą od kontekstu Twojej firmy - porozmawiajmy."
  />
</BaseLayout>
