/* ── Dla kogo ─────────────────────────────────────────────────────────── */
.edu-segments {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.25rem;
}
@media (min-width: 980px) {
  /* Sześć kolumn pozwala ułożyć pięć kart bez pustego miejsca: trzy karty po
     dwie kolumny w pierwszym rzędzie, dwie po trzy kolumny w drugim. */
  .edu-segments { grid-template-columns: repeat(6, 1fr); }
  .edu-segments > * { grid-column: span 2; }
  .edu-segments > :nth-child(4),
  .edu-segments > :nth-child(5) { grid-column: span 3; }
}
.edu-segment {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
