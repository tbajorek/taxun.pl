.edu-note a { color: var(--accent-700); text-decoration: underline; text-underline-offset: 3px; }
.edu-lede-center {
  margin-top: 1.75rem;
  text-align: center;
  max-width: 72ch;
  margin-inline: auto;
  font-size: 0.9375rem;
  color: var(--text-muted);
  line-height: 1.7;
}
.edu-subhead {
  font-size: 1.375rem;
  margin-top: 2.5rem;
  margin-bottom: 1.25rem;
}
.edu-pill {
