const hrEtat = hrPricing.find((h) => h.id === 'uop')?.price ?? hrMin;

/**
 * Wiersz cennika składany z danych z src/data/pricing.ts - dzięki temu tabela
 * na tej podstronie nie może rozjechać się z cennikiem po zmianie stawek.
 * W edukacji spora część usług jest zwolniona przedmiotowo z VAT, więc obie
 * kolumny cennika są tu realnie używane i wybór kolumny jest parametrem.
 */
const priceRow = (
  id: 'ryczalt' | 'kpir' | 'fk',
  upTo: number,
  vat: 'noVat' | 'withVat',
  situation: string
) => {
  const table = tables.find((t) => t.id === id);
  const bucket = table?.buckets.find((b) => b.upTo === upTo);
  const price = table?.hasVat ? bucket?.[vat] : bucket?.price;
  return {
    form: table?.shortName ?? '',
    vatLabel: table?.hasVat ? (vat === 'noVat' ? 'zwolniony z VAT' : 'czynny podatnik VAT') : '',
    docs: (bucket?.range ?? '').replace(/\s{2,}/g, ' '),
    situation,
    price: typeof price === 'number' ? price : null,
  };
};

