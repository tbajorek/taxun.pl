/**
 * Wiersz cennika składany z danych z src/data/pricing.ts, żeby tabela na tej
 * podstronie nie mogła rozjechać się z cennikiem po zmianie stawek.
 *
 * U wynajmującego o kolumnie decyduje status w VAT i liczba dokumentów, a nie
 * liczba rezerwacji: sprzedaż z każdej platformy podsumowuje jedno zestawienie
 * okresowe, a czynsz z umowy długoterminowej to jedna pozycja miesięcznie.
 */
const priceRow = (
  id: 'ryczalt' | 'kpir' | 'fk',
  upTo: number,
  vat: 'noVat' | 'withVat',
  situation: string
) => {
  const table = tables.find((t) => t.id === id);
  const bucket = table?.buckets.find((b) => b.upTo === upTo);
  const price = table?.hasVat ? bucket?.[vat] : bucket?.price;
  return {
    form: table?.shortName ?? '',
    vatLabel: table?.hasVat ? (vat === 'noVat' ? 'zwolniony z VAT' : 'czynny podatnik VAT') : '',
    docs: (bucket?.range ?? '').replace(/\s{2,}/g, ' '),
    situation,
    price: typeof price === 'number' ? price : null,
  };
};

