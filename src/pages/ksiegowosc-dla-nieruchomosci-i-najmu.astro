  font-size: 0.875rem;
  font-weight: 500;
  color: var(--text-on-dark);
}
.hero-badges :global(svg) { color: var(--accent-400); flex-shrink: 0; }

/* ── Wspólne elementy ─────────────────────────────────────────────────── */
.nrh-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 2rem;
  justify-content: center;
}
.nrh-note {
  display: flex;
  gap: 0.75rem;
  align-items: flex-start;
  margin-top: 1.75rem;
  padding: 1.125rem 1.375rem;
  background: var(--accent-50);
  border: 1px solid var(--accent-200);
  border-radius: var(--radius-lg);
  font-size: 0.9375rem;
  line-height: 1.65;
  color: var(--ink-900);
}
.nrh-note :global(svg) { color: var(--accent-700); flex-shrink: 0; margin-top: 4px; }
.nrh-note a { color: var(--accent-700); text-decoration: underline; text-underline-offset: 3px; }

.nrh-pill {
  display: inline-flex;
  font-family: var(--font-display);
  font-size: 0.9375rem;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  padding: 0.3rem 0.85rem;
  border-radius: var(--radius-full);
  line-height: 1.3;
  white-space: nowrap;
}
.nrh-pill--good { background: var(--accent-500); color: var(--ink-950); }
.nrh-pill--neutral { background: var(--ink-100); color: var(--ink-800); }
.nrh-pill--warn { background: #FEF3C7; color: #92400E; }

/* ── Dla kogo ─────────────────────────────────────────────────────────── */
.nrh-segments {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.25rem;
}
@media (min-width: 980px) {
  /* Sześć kolumn układa pięć kart po trzy w rzędzie, a dwie ostatnie
     rozkładają się symetrycznie w drugim wierszu. */
  .nrh-segments { grid-template-columns: repeat(6, 1fr); }
  .nrh-segments > * { grid-column: span 2; }
  .nrh-segments > :nth-child(4) { grid-column: 2 / span 2; }
  .nrh-segments > :nth-child(5) { grid-column: 4 / span 2; }
}
.nrh-segment {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
  transition: transform var(--transition-base), box-shadow var(--transition-base);
}
.nrh-segment:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
.nrh-segment__icon {
  width: 44px; height: 44px;
  border-radius: var(--radius-md);
  background: var(--accent-50);
  color: var(--accent-700);
  display: grid; place-items: center;
}
.nrh-segment h3 { font-size: 1.125rem; }
.nrh-segment > p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.55; }
.nrh-segment ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-top: auto;
  padding-top: 0.5rem;
}
.nrh-segment li {
  display: flex;
  gap: 0.5rem;
  align-items: flex-start;
  font-size: 0.875rem;
  color: var(--text);
}
.nrh-segment li :global(svg) { color: var(--accent-600); flex-shrink: 0; margin-top: 4px; }

/* ── Progi ryczałtu ───────────────────────────────────────────────────── */
.nrh-tiers {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.25rem;
}
@media (min-width: 900px) { .nrh-tiers { grid-template-columns: repeat(3, 1fr); } }
.nrh-tier {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.nrh-tier--featured {
  border-color: var(--accent-200);
  background: linear-gradient(180deg, var(--accent-50), var(--white));
}
.nrh-tier__value {
  display: inline-flex;
  align-self: flex-start;
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  padding: 0.25rem 0.75rem;
  border-radius: var(--radius-full);
  background: var(--ink-100);
  color: var(--ink-800);
  white-space: nowrap;
}
.nrh-tier__value--featured { background: var(--accent-500); color: var(--ink-950); }
.nrh-tier h3 { font-size: 1.0625rem; }
.nrh-tier p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.65; }

.nrh-notes {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
  gap: 1.25rem;
  margin-top: 1.75rem;
}
@media (min-width: 980px) { .nrh-notes { grid-template-columns: repeat(3, 1fr); } }
.nrh-note-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
}
.nrh-note-card__head {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  margin-bottom: 0.75rem;
}
.nrh-note-card__head h3 { font-size: 1.0625rem; }
.nrh-note-card :global(svg) { color: var(--accent-600); flex-shrink: 0; }
.nrh-note-card p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.65; }

/* ── Stawki VAT ───────────────────────────────────────────────────────── */
.nrh-rates {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}
.nrh-rates__head,
.nrh-rates__row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 1.25rem;
  align-items: center;
  padding: 1.125rem 1.5rem;
}
.nrh-rates__head {
  background: var(--ink-50);
  border-bottom: 1px solid var(--border);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-subtle);
}
.nrh-rates__row { border-bottom: 1px solid var(--border-subtle); }
.nrh-rates__row:last-child { border-bottom: none; }
.nrh-rates__what strong { display: block; color: var(--text-strong); font-weight: 600; font-size: 0.9375rem; line-height: 1.45; }
.nrh-rates__what small { display: block; font-size: 0.8125rem; color: var(--text-subtle); margin-top: 4px; line-height: 1.5; }
.nrh-rates__rate { text-align: right; }

.nrh-traps {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.25rem;
  margin-top: 1.25rem;
}
@media (min-width: 900px) { .nrh-traps { grid-template-columns: repeat(2, 1fr); } }
.nrh-trap {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
  display: flex;
  flex-direction: column;
}
.nrh-trap--warn { border-color: #FDE68A; background: linear-gradient(180deg, #FFFBEB, var(--white)); }
.nrh-trap__badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  align-self: flex-start;
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.35rem 0.7rem;
  border-radius: var(--radius-full);
  background: var(--ink-100);
  color: var(--text-muted);
  margin-bottom: 0.875rem;
  line-height: 1.35;
}
.nrh-trap__badge :global(svg) { flex-shrink: 0; }
.nrh-trap--warn .nrh-trap__badge { background: #FEF3C7; color: #92400E; }
.nrh-trap h3 { font-size: 1.125rem; margin-bottom: 0.5rem; }
.nrh-trap p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.65; }
.nrh-trap__foot {
  /* `auto` dosuwa stopkę do dołu karty, więc separatory w rzędzie stoją
     równo mimo różnej długości opisów. */
  margin-top: auto;
  padding-top: 0.875rem;
  border-top: 1px solid var(--border-subtle);
  font-size: 0.875rem;
  color: var(--text-subtle);
  line-height: 1.6;
}

/* ── Platformy rezerwacyjne ───────────────────────────────────────────── */
.nrh-platform__main {
  background: var(--ink-900);
  border-radius: var(--radius-2xl);
  padding: clamp(1.75rem, 4vw, 2.5rem);
  color: var(--text-on-dark);
}
.nrh-platform__icon {
  width: 44px; height: 44px;
  border-radius: var(--radius-md);
  background: rgba(16,185,129,0.16);
  color: var(--accent-400);
  display: grid; place-items: center;
  margin-bottom: 1.125rem;
}
.nrh-platform__main h3 { color: var(--white); font-size: 1.25rem; margin-bottom: 0.75rem; }
.nrh-platform__main p { font-size: 0.9375rem; color: var(--text-on-dark-muted); line-height: 1.75; }
.nrh-platform__main p + p { margin-top: 0.875rem; }
.nrh-platform__main ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-top: 1.25rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(255,255,255,0.12);
}
.nrh-platform__main li {
  display: flex;
  gap: 0.5rem;
  align-items: flex-start;
  font-size: 0.9375rem;
  color: var(--text-on-dark);
  line-height: 1.5;
}
.nrh-platform__main li :global(svg) { color: var(--accent-400); flex-shrink: 0; margin-top: 5px; }
@media (min-width: 900px) {
  /* Trzy punkty z listy stają obok siebie, żeby ciemny panel nie rósł w słupek
     i nie zostawiał pustego miejsca nad kartami pod nim. */
  .nrh-platform__main ul { flex-direction: row; gap: 1.5rem; }
  .nrh-platform__main li { flex: 1; }
}

.nrh-platform__cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.25rem;
  margin-top: 1.25rem;
  align-items: start;
}
@media (min-width: 980px) { .nrh-platform__cards { grid-template-columns: repeat(3, 1fr); } }
.nrh-platform__card {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
}
.nrh-platform__card--warn { border-color: #FDE68A; background: linear-gradient(180deg, #FFFBEB, var(--white)); }
.nrh-platform__badge {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 0.4rem;
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.35rem 0.7rem;
  border-radius: var(--radius-full);
  background: var(--ink-100);
  color: var(--text-muted);
  margin-bottom: 0.875rem;
  line-height: 1.35;
}
.nrh-platform__badge :global(svg) { flex-shrink: 0; }
.nrh-platform__card--warn .nrh-platform__badge { background: #FEF3C7; color: #92400E; }
.nrh-platform__card p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.65; }
.nrh-platform__foot {
  margin-top: auto;
  padding-top: 0.875rem;
  border-top: 1px solid var(--border-subtle);
  font-size: 0.875rem;
  color: var(--text-subtle);
  line-height: 1.6;
}

/* ── Obiekty noclegowe ────────────────────────────────────────────────── */
.nrh-objects {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.25rem;
}
@media (min-width: 980px) { .nrh-objects { grid-template-columns: repeat(3, 1fr); } }
.nrh-object {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 1.75rem;
}
.nrh-object__head {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  margin-bottom: 0.75rem;
}
.nrh-object__head h3 { font-size: 1.0625rem; }
.nrh-object :global(svg) { color: var(--accent-600); flex-shrink: 0; }
.nrh-object p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.65; }

.nrh-docs {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.25rem;
  margin-top: 1.25rem;
}
@media (min-width: 900px) { .nrh-docs { grid-template-columns: repeat(2, 1fr); } }
.nrh-docs__col {
  background: linear-gradient(180deg, var(--accent-50), var(--white));
  border: 1px solid var(--accent-200);
  border-radius: var(--radius-2xl);
  padding: clamp(1.75rem, 4vw, 2.25rem);
  display: flex;
  flex-direction: column;
}
.nrh-docs__badge {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 0.4rem;
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.35rem 0.7rem;
  border-radius: var(--radius-full);
  background: var(--accent-100);
  color: var(--accent-700);
  margin-bottom: 0.875rem;
}
.nrh-docs__badge :global(svg) { flex-shrink: 0; }
.nrh-docs__col h3 { font-size: 1.1875rem; margin-bottom: 0.625rem; }
.nrh-docs__col p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.7; }
.nrh-docs__col p + p { margin-top: 0.75rem; }
.nrh-docs__col ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-top: 0.875rem;
}
.nrh-docs__col li {
  display: flex;
  gap: 0.5rem;
  align-items: flex-start;
  font-size: 0.9375rem;
  color: var(--text);
  line-height: 1.5;
}
.nrh-docs__col li :global(svg) { color: var(--accent-600); flex-shrink: 0; margin-top: 5px; }
.nrh-docs__foot {
  margin-top: auto;
  padding-top: 0.875rem;
  border-top: 1px solid var(--accent-200);
  font-size: 0.875rem;
  color: var(--text-subtle);
  line-height: 1.6;
}

/* ── Podatek od nieruchomości ─────────────────────────────────────────── */
.nrh-tax {
  margin-top: 1.75rem;
  padding: clamp(1.75rem, 4vw, 2.5rem);
  background: var(--ink-900);
  border-radius: var(--radius-2xl);
  color: var(--text-on-dark);
}
.nrh-tax__head { max-width: 72ch; }
.nrh-tax__head h3 { color: var(--white); font-size: clamp(1.25rem, 2.5vw, 1.625rem); margin: 0.5rem 0 0.75rem; }
.nrh-tax__head p { font-size: 0.9375rem; color: var(--text-on-dark-muted); line-height: 1.75; }
.nrh-tax__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1rem;
  margin-top: 1.75rem;
}
@media (min-width: 900px) { .nrh-tax__grid { grid-template-columns: repeat(3, 1fr); } }
.nrh-tax__card {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-xl);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.nrh-tax__card--featured { border-color: var(--accent-500); background: rgba(16,185,129,0.1); }
.nrh-tax__value {
  display: inline-flex;
  align-self: flex-start;
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  padding: 0.25rem 0.75rem;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.1);
  color: var(--white);
  white-space: nowrap;
}
.nrh-tax__value--featured { background: var(--accent-500); color: var(--ink-950); }
.nrh-tax__card h4 { color: var(--white); font-size: 1rem; font-family: var(--font-display); }
.nrh-tax__card p { font-size: 0.875rem; color: var(--text-on-dark-muted); line-height: 1.65; }
.nrh-tax__foot {
  margin-top: 1.5rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(255,255,255,0.12);
  font-size: 0.9375rem;
  color: var(--text-on-dark-muted);
  line-height: 1.75;
}

/* ── Zakres obsługi ───────────────────────────────────────────────────── */
.nrh-scope {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1.25rem;
}
@media (min-width: 980px) { .nrh-scope { grid-template-columns: repeat(2, 1fr); } }
.nrh-scope__item {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}
.nrh-scope__item:hover { border-color: var(--ink-100); box-shadow: var(--shadow-sm); }
.nrh-scope__icon {
  flex-shrink: 0;
  width: 44px; height: 44px;
  border-radius: var(--radius-md);
  background: var(--accent-50);
  color: var(--accent-700);
  display: grid; place-items: center;
}
.nrh-scope__item h3 { font-size: 1.0625rem; margin-bottom: 0.375rem; }
.nrh-scope__item p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.6; }
.nrh-scope__item ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-top: 0.875rem;
}
.nrh-scope__item li {
  display: flex;
  gap: 0.5rem;
  align-items: flex-start;
  font-size: 0.875rem;
  color: var(--text);
}
.nrh-scope__item li :global(svg) { color: var(--accent-600); flex-shrink: 0; margin-top: 4px; }

/* ── Dlaczego Taxun ───────────────────────────────────────────────────── */
.nrh-benefits {
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: start;
}
@media (max-width: 900px) { .nrh-benefits { grid-template-columns: 1fr; } }
.nrh-benefits .lede { margin-top: 1rem; }
.nrh-benefits__stats { margin-top: 2rem; }
.nrh-benefits__link { margin-top: 1.75rem; }
.nrh-benefits__list {
  list-style: none;
  display: grid;
  gap: 1rem;
}
.nrh-benefits__list li {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1.25rem;
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}
.nrh-benefits__list li:hover { border-color: var(--ink-100); box-shadow: var(--shadow-sm); }
.nrh-benefits__icon {
  flex-shrink: 0;
  width: 44px; height: 44px;
  border-radius: var(--radius-md);
  background: var(--accent-50);
  color: var(--accent-700);
  display: grid; place-items: center;
}
.nrh-benefits__list h3 { font-size: 1.0625rem; margin-bottom: 0.25rem; }
.nrh-benefits__list p { font-size: 0.9375rem; color: var(--text-muted); line-height: 1.6; }

/* ── Zakładanie firmy ─────────────────────────────────────────────────── */
.nrh-startup {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius-2xl);
  padding: clamp(1.75rem, 4vw, 3rem);
}
.nrh-startup__head { max-width: 70ch; }
.nrh-startup__head .lede { margin-top: 1rem; }
.nrh-steps {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1rem;
  margin: 2rem 0;
}
@media (min-width: 980px) { .nrh-steps { grid-template-columns: repeat(3, 1fr); } }
.nrh-step {
  display: flex;
  gap: 0.875rem;
  align-items: flex-start;
  background: var(--surface-alt);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 1.25rem;
}
.nrh-step__num {
  flex-shrink: 0;
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  color: var(--accent-700);
  background: var(--accent-100);
  border-radius: var(--radius-sm);
  padding: 0.25rem 0.5rem;
  margin-top: 2px;
}
.nrh-step h3 { font-size: 1rem; margin-bottom: 0.25rem; }
.nrh-step p { font-size: 0.875rem; color: var(--text-muted); line-height: 1.6; }

.nrh-startup__cols {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1rem;
}
@media (min-width: 900px) { .nrh-startup__cols { grid-template-columns: repeat(2, 1fr); } }
.nrh-startup__col {
  background: var(--surface-alt);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}
.nrh-startup__col--primary {
  background: linear-gradient(180deg, var(--accent-50), var(--white));
  border-color: var(--accent-200);
}
