const vatPodstawowy = pct(VAT_RATE);
const limitVat = zl(VAT_ZWOLNIENIE_LIMIT);
/** Dopłata za miesiąc, w którym u podatnika zwolnionego z VAT wystąpił import usług. */
const modulVatUe = foreignTax.vat9m;
const pitNajem = personalReturns.rent;
/** Najtańszy wariant obsługi kadrowej - umowa cywilnoprawna bez składek ZUS. */
