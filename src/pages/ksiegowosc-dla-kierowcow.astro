  CAR_LIMIT,
  CAR_LIMIT_LEGACY,
  CO2_THRESHOLD,
  CO2_TYPICAL,
  DAC7_OD,
  DAC7_RAPORT_DO,
  DMC_SAMOCHOD_OSOBOWY,
  KASA_LIMIT_ROCZNY,
  KASA_ULGA_MAX,
  KASA_ULGA_RATE,
  PIT_FREE_AMOUNT,
  PIT_RATE_1,
  PIT_RATE_2,
  PIT_RATE_LINIOWY,
  PIT_THRESHOLD,
  PKD_NOWA_OD,
  RYCZALT_TRANSPORT,
  RYCZALT_USLUGI,
  TAX_YEAR,
  TRANSPORT_LADOWNOSC_PROG,
  VAT_MIXED_DEDUCT,
  VAT_RATE,
  VAT_RATE_OBNIZONA,
  VAT_TAXI_OKRES_MIESIACE,
  VAT_TAXI_RYCZALT,
  VAT_TAXI_RYCZALT_USTAWOWY,
  VAT_TAXI_RYCZALT_WYLACZENIA,
  VAT_ZWOLNIENIE_LIMIT,
