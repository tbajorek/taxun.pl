import { num, pct, zl } from '../lib/format';
import { industriesLabel, site } from '../data/site';

const fmt = new Intl.NumberFormat('pl-PL');
const ryczalt = startsFrom('ryczalt');
const kpir = startsFrom('kpir');
const fk = startsFrom('fk');
const stawkaOsoby = pct(RYCZALT_USLUGI);
const stawkaTowary = pct(RYCZALT_TRANSPORT);
const stawkaLiniowy = pct(PIT_RATE_LINIOWY);
const vatObnizony = pct(VAT_RATE_OBNIZONA);
const vatPodstawowy = pct(VAT_RATE);
const vatTaxi = pct(VAT_TAXI_RYCZALT);
const vatTaxiStary = pct(VAT_TAXI_RYCZALT_USTAWOWY);
const limitVat = zl(VAT_ZWOLNIENIE_LIMIT);
const limitKasy = zl(KASA_LIMIT_ROCZNY);
const eksploatacja = pct(CAR_EKSPLOATACJA_LIMIT);
const odliczenieMieszane = pct(VAT_MIXED_DEDUCT);
const dmc = num(DMC_SAMOCHOD_OSOBOWY);
const ladownosc = num(TRANSPORT_LADOWNOSC_PROG);
/** Najtańszy wariant obsługi kadrowej - umowa cywilnoprawna bez składek ZUS. */
const hrZlecenie = hrPricing.find((h) => h.id === 'zlecenie')?.price ?? hrMin;

/**
 * Wiersz cennika składany z danych z src/data/pricing.ts, żeby tabela na tej
 * podstronie nie mogła rozjechać się z cennikiem po zmianie stawek.
 *
 * U kierowcy o kolumnie decyduje status w VAT i liczba faktur kosztowych, a nie
 * liczba kursów: sprzedaż dla pasażerów podsumowuje raport okresowy z kasy,
 * a rozliczenie z platformą - zestawienie z panelu kierowcy.
 */
const priceRow = (
  id: 'ryczalt' | 'kpir' | 'fk',
  upTo: number,
  vat: 'noVat' | 'withVat',
  situation: string
) => {
  const table = tables.find((t) => t.id === id);
  const bucket = table?.buckets.find((b) => b.upTo === upTo);
  const price = table?.hasVat ? bucket?.[vat] : bucket?.price;
  return {
    form: table?.shortName ?? '',
    vatLabel: table?.hasVat ? (vat === 'noVat' ? 'zwolniony z VAT' : 'czynny podatnik VAT') : '',
    docs: (bucket?.range ?? '').replace(/\s{2,}/g, ' '),
    situation,
    price: typeof price === 'number' ? price : null,
  };
};

const priceRows = [
  priceRow('ryczalt', 10, 'noVat', 'Kierowca pracujący sam, korzystający jeszcze ze zwolnienia z VAT'),
  priceRow('ryczalt', 10, 'withVat', 'Kierowca będący czynnym podatnikiem VAT, kilka faktur kosztowych miesięcznie'),
  priceRow('kpir', 10, 'withVat', 'Kierowca rozliczający koszty pojazdu, dokumenty zbierane raz w miesiącu'),
  priceRow('kpir', 20, 'withVat', 'Duży przebieg, codzienne tankowanie, faktury za serwis i opłaty drogowe'),
  priceRow('fk', 10, 'withVat', 'Firma transportowa prowadzona w formie spółki'),
];

