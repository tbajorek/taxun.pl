 */
const rates = [
  {
    what: 'Przewóz osób taksówką oraz przewozy realizowane przez aplikacje',
    detail: 'taxi, Uber, Bolt, FreeNow, iTaxi, przewozy na zlecenie korporacji',
    rate: stawkaOsoby,
    tone: 'neutral',
  },
  {
