  <!-- Additional services -->
  <section class="section" id="dodatkowe">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Usługi dodatkowe</span>
        <h2>Co wchodzi w abonament, a&nbsp;co&nbsp;rozliczamy osobno</h2>
        <p>Czynności rozliczane od sztuki albo jednorazowo. Stałe dopłaty miesięczne opisujemy wyżej, w <a href="#moduly">modułach specjalnych</a>. Razem z tabelami i modułami to cała lista opłat, jakie możemy doliczyć - żadnych niespodzianek na fakturze.</p>
      </div>

      <div class="adds">
        <div class="adds__col adds__col--free">
          <h3><span class="adds__pill adds__pill--free">w cenie abonamentu</span></h3>
          <ul>
            {freeAdds.map((a) => (
              <li>
                <span class="adds__icon adds__icon--free"><Icon name={a.icon} size={16}/></span>
                <span class="adds__name">
                  {a.name}
                  {a.note && <small>{a.note}</small>}
                </span>
                <span class="adds__price adds__price--free">{a.price}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="adds__col adds__col--paid">
          <h3><span class="adds__pill">płatne dodatkowo</span></h3>
          <ul>
            {paidAdds.map((a) => (
              <li>
                <span class="adds__icon"><Icon name={a.icon} size={16}/></span>
                <span class="adds__name">
                  {a.name}
                  {a.note && <small>{a.note}</small>}
                </span>
                <span class="adds__price">{a.price}</span>
              </li>
            ))}
          </ul>
