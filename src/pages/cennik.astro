                    <div class="pricing-table__range" role="cell">{b.range}</div>
                    <div class="pricing-table__price is-active" role="cell">{formatPrice(b.price)}</div>
                    <div class="pricing-table__cta" role="cell">
                      <a href={`/wycena?plan=${t.id}-${b.upTo ?? 'custom'}`} class="btn btn--primary btn--sm">
