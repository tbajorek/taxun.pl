  const vatGroup = document.getElementById('pricing-vat') as HTMLElement | null;
  const vatBtns = document.querySelectorAll<HTMLButtonElement>('.pricing-vat__btn');

  function applyForm(form: string) {
    formBtns.forEach((b) => {
      const active = b.dataset.form === form;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-selected', String(active));
    });
    wraps.forEach((w) => w.classList.toggle('is-hidden', w.dataset.form !== form));
    // VAT toggle disabled for KH
    if (vatGroup) vatGroup.classList.toggle('is-disabled', form === 'fk');
  }

  const planLinks = document.querySelectorAll<HTMLAnchorElement>('a[data-plan-vat]');

  function applyVat(mode: 'on' | 'off') {
    vatBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.vat === mode));
    vatGroup?.setAttribute('data-vat', mode);
    document.querySelectorAll<HTMLElement>('.pricing-col--withvat').forEach((el) =>
      el.classList.toggle('is-active', mode === 'on')
    );
    document.querySelectorAll<HTMLElement>('.pricing-col--novat').forEach((el) =>
      el.classList.toggle('is-active', mode === 'off')
    );
    // Carry the selected VAT status over to the contact form.
    planLinks.forEach((a) => {
      a.href = `/wycena?plan=${a.dataset.planVat}&vat=${mode}`;
    });
  }

  formBtns.forEach((b) => b.addEventListener('click', () => applyForm(b.dataset.form!)));
  vatBtns.forEach((b) => b.addEventListener('click', () => applyVat(b.dataset.vat as 'on' | 'off')));
</script>
