---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { tables, includedInPlan, hrPricing, hrMin, additional, bundleDiscount, comparison, comparisonChecked, currentPricingNote, discountsNote, ecommerce, foreignTax, hiddenFeesPerYear, ipBox, ossFees, personalReturns, specialModules, surcharges, surchargeLabel, surchargeFreeUntilDay, discounts, setupFees, startsFrom, endsAt } from '../data/pricing';
import { VAT_ZWOLNIENIE_LIMIT } from '../lib/tax-constants';
import { num, zl } from '../lib/format';

const fmt = new Intl.NumberFormat('pl-PL');
const formatPrice = (v: number | 'custom' | undefined) =>
  v === 'custom' ? 'wycena ind.' : v == null ? '-' : `${fmt.format(v)} zł`;

/**
 * Dopisek czytany wyłącznie przez czytnik ekranu przy przyciskach w tabelach.
 * Widoczny tekst to samo "Wybierz" albo "Wycena indyw.", a przycisków jest 21 -
 * bez tego dopisku wszystkie brzmią identycznie. Przyimek zależy od wariantu,
 * żeby zdanie było poprawne w obu przypadkach.
 */
const bucketHint = (custom: boolean, name: string, range: string) =>
  `${custom ? ' dla pakietu ' : ' pakiet '}${name}, ${range} dokumentów miesięcznie`;

/** Stawka kadrowa po identyfikatorze umowy - żeby FAQ nie powtarzało kwot z tabeli. */
const hrPrice = (id: string) => hrPricing.find((h) => h.id === id)?.price ?? hrMin;

const freeAdds = additional.filter((a) => a.category === 'free');
const paidAdds = additional.filter((a) => a.category === 'paid');

const breadcrumbs = [{ label: 'Cennik', href: '/cennik' }];

// Generate OfferCatalog from pricing tables
const offerItems = tables.flatMap((t) =>
  t.buckets
    .filter((b) => b.upTo !== null)
    .map((b) => {
      const price = t.hasVat ? (b.withVat ?? b.noVat) : b.price;
      if (price === 'custom' || price == null) return null;
      return {
        '@type': 'Offer',
        name: `${t.shortName} - do ${b.upTo} dokumentów`,
        description: `${t.tagline} Liczba dokumentów: ${b.range}.`,
        price: String(price),
        priceCurrency: 'PLN',
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: String(price),
          priceCurrency: 'PLN',
          unitText: 'mies.',
        },
        url: `https://taxun.pl/cennik#${t.id}`,
        availability: 'https://schema.org/InStock',
        seller: { '@id': 'https://taxun.pl/#organization' },
      };
    })
    .filter(Boolean)
);

const offerCatalogSchema = {
  '@type': 'OfferCatalog',
  '@id': 'https://taxun.pl/cennik#offers',
  name: 'Cennik biura rachunkowego Taxun',
  url: 'https://taxun.pl/cennik',
  itemListElement: offerItems,
};

/*
 * Pakiety opisujemy jako `Service`, tak samo jak podstrony usług. Typ `Product`
 * uruchamiał w Google walidację fragmentów produktowych, która oczekuje pól
 * `aggregateRating` i `review` - a opinii o własnej usłudze nie wystawiamy
 * sobie sami. Księgowość nie jest towarem, więc `Service` jest tu i poprawny,
 * i wolny od tego wymagania.
 */
const packageSchemas = tables.map((t) => ({
  '@type': 'Service',
  '@id': `https://taxun.pl/cennik#${t.id}-service`,
  name: t.name,
  serviceType: t.name,
  description: t.tagline,
  provider: { '@id': 'https://taxun.pl/#organization' },
  areaServed: [{ '@type': 'Country', name: 'Polska' }, { '@type': 'City', name: 'Kraków' }],
  url: `https://taxun.pl/cennik#${t.id}`,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'PLN',
    lowPrice: String(t.startsFrom),
    highPrice: String(endsAt(t.id)),
    offerCount: t.buckets.filter((b) => b.upTo !== null).length,
    url: `https://taxun.pl/cennik#${t.id}`,
  },
}));

const faq = [
  { q: 'Co dokładnie zawiera abonament?', a: 'Każdy pakiet to <strong>all-inclusive</strong> - w cenie masz prowadzenie ksiąg lub ewidencji, deklaracje VAT, ZUS właściciela, JPK_V7M/K, KSeF (wysyłkę i odbiór e-faktur), OCR dokumentów, portal klienta online, rejestrację do VAT-UE wraz z informacjami podsumowującymi oraz roczne zeznanie PIT/CIT w części dotyczącej działalności. Przy księgach handlowych dodatkowo wliczone jest sprawozdanie finansowe i e-sprawozdanie do KRS. Poza abonamentem zostają <a href="#moduly">moduły specjalne</a> - dopłaty, które włącza konkretna procedura, a nie liczba dokumentów - oraz czynności rozliczane od sztuki, na przykład prywatny PIT-37 właściciela.' },
  { q: 'Czym są moduły specjalne i czym różnią się od pakietu?', a: `Pakiet księgowy wyceniamy liczbą dokumentów, bo to ona odpowiada za większość pracy. Moduł specjalny włącza natomiast konkretna procedura i kosztuje tyle samo przy dwudziestu dokumentach co przy dwustu. Najczęstszy przykład: jeśli jesteś <strong>zwolniony z VAT i kupisz reklamę albo subskrypcję od firmy zagranicznej</strong>, musisz zarejestrować się do VAT-UE jeszcze przed pierwszym takim zakupem i rozliczać import usług deklaracją VAT-9M - to ${foreignTax.vat9m} zł netto za miesiąc, w którym zakup wystąpił, mimo że Twoja księgowość nie urosła ani o jeden dokument. Tak samo działają procedury OSS (${ossFees.ossMonthly} zł netto/mies.) i IOSS (${ossFees.iossMonthly} zł netto/mies.), każdy kanał sprzedaży ponad pierwszy, czyli kolejna platforma typu Amazon, Etsy czy eBay (${ecommerce.channelRate} zł netto/mies.), oraz ewidencja IP Box (${ipBox.monthly} zł netto/mies.). Moduł płacisz tylko wtedy, gdy dana procedura faktycznie u Ciebie występuje, i wyłączasz go razem z nią. Pełna lista jest w sekcji <a href="#moduly">modułów specjalnych</a>.` },
  { q: 'Czym różni się cena „bez VAT” od ceny „z VAT”?', a: `Stawka „bez VAT” dotyczy podatników zwolnionych z VAT. Zwolnienie podmiotowe obowiązuje do limitu sprzedaży ${zl(VAT_ZWOLNIENIE_LIMIT)} rocznie, a zwolnienie przedmiotowe, na przykład dla usług medycznych czy edukacyjnych, nie jest limitowane obrotem. Stawka „z VAT” obejmuje pełną obsługę rejestrów VAT, JPK i KSeF dla czynnych podatników VAT. Płacisz za zakres pracy, którą faktycznie wykonujemy.` },
  { q: 'Fakturuję wyłącznie firmy z zagranicy. Którą stawkę u Was płacę?', a: 'Stawkę "bez VAT". Usługi, których miejsce opodatkowania znajduje się poza Polską, nie są sprzedażą krajową, więc nie wliczają się do limitu zwolnienia podmiotowego i możesz pozostać podatnikiem zwolnionym mimo wysokich przychodów. Rejestracja do VAT-UE, informacje podsumowujące oraz faktury z odwrotnym obciążeniem mieszczą się w abonamencie i nie zmieniają stawki. Szczegóły opisujemy na stronie <a href="/ksiegowosc-dla-programistow#vat">księgowości dla programistów</a>.' },
  { q: 'Kupuję reklamy i subskrypcje od firm zagranicznych. Czy to zmienia cenę?', a: `Zależy od tego, czy jesteś czynnym podatnikiem VAT. Weryfikacja obowiązków, rejestracja do VAT-UE, informacje podsumowujące oraz rozliczenie importu usług u czynnego podatnika VAT mieszczą się w abonamencie. Jeśli jesteś <strong>zwolniony z VAT</strong>, ten sam zakup uruchamia odrębny obieg: deklarację VAT-9M, przelew do urzędu i informację podsumowującą, więc za miesiące, w których import usług wystąpił, doliczamy ${foreignTax.vat9m} zł netto. Nie doliczamy nic za miesiące bez takich zakupów. Roczna informacja IFT-2R kosztuje ${foreignTax.ift2rFirst} zł za pierwszego zagranicznego kontrahenta i ${foreignTax.ift2rNext} zł za każdego kolejnego, wraz z weryfikacją obowiązku i skompletowaniem certyfikatu rezydencji. Przy zawarciu umowy bezpłatnie sprawdzamy też, czy w dotychczasowych rozliczeniach nie ma zaległości w tym obszarze. Szczegóły opisujemy na stronie <a href="/ksiegowosc-dla-marketingu-i-branz-kreatywnych#zakupy-zagraniczne">księgowości dla marketingu</a>.` },
  { q: 'Jak liczona jest liczba dokumentów?', a: `Dokument to każdy wpis księgowy: faktura sprzedaży, faktura kosztowa, ewidencja środka trwałego, lista płac, wyciąg bankowy, naliczenie amortyzacji. <strong>Deklaracje wysyłane do urzędów</strong> (JPK_V7, ZUS, PIT) <strong>nie wliczają</strong> się do tego limitu. Wyciąg bankowy i raport z bramki płatniczej liczymy po ${ecommerce.linesPerDoc} pozycji na dokument. Przy sprzedaży internetowej dochodzi przelicznik zestawień sprzedaży, opisany w pytaniu poniżej.` },
  { q: 'Prowadzę sklep internetowy. Jak liczycie sprzedaż z platform?', a: `Sprzedaż ze sklepu i z platform nie trafia do ksiąg pojedynczo, tylko zbiorczym zestawieniem za okres. Zestawienie z jednego kanału obejmujące <strong>do ${ecommerce.txPerDoc} transakcji liczymy jako jeden dokument</strong>, a każde rozpoczęte kolejne ${ecommerce.txPerDoc} transakcji jako kolejny. Do transakcji wliczamy sprzedaż razem ze zwrotami i korektami. Bez tego przelicznika sklep z trzema tysiącami zamówień płaciłby tyle samo co sprzedawca z dwudziestoma, a taka cena skończyłaby się dopłatą po pierwszym miesiącu. Osobno rozliczamy kanały sprzedaży: pierwszy jest w cenie pakietu, każdy kolejny to ${ecommerce.channelRate} zł netto miesięcznie, bo ma własny format raportu, strukturę prowizji i cykl wypłat. Trzy policzone przykłady podajemy na stronie <a href="/ksiegowosc-dla-e-commerce#cennik">księgowości dla e-commerce</a>.` },
  { q: 'Sprzedaję do konsumentów w Unii Europejskiej. Ile kosztuje procedura OSS?', a: `Rejestracja do procedury VAT OSS to ${ossFees.ossSetup} zł jednorazowo, a obsługa ${ossFees.ossMonthly} zł netto miesięcznie: monitorowanie progu, przypisanie stawek obowiązujących w kraju nabywcy, deklaracja kwartalna i pilnowanie terminu płatności. Procedura IOSS, dla towarów sprowadzanych spoza Unii, kosztuje ${ossFees.iossSetup} zł za rejestrację i ${ossFees.iossMonthly} zł miesięcznie, ponieważ deklaracje składa się tam co miesiąc, a nie co kwartał. <strong>Rejestracja do VAT-UE, informacje podsumowujące oraz sprzedaż firmom z Unii pozostają w abonamencie</strong>, bez dopłat. Rejestracji do VAT w innych krajach nie prowadzimy samodzielnie - wskazujemy wyspecjalizowanego partnera.` },
  { q: 'Co jeśli przekroczę limit dokumentów w danym miesiącu?', a: 'Automatycznie naliczamy stawkę odpowiednią do liczby dokumentów w danym miesiącu. Płacisz dokładnie za to, co rzeczywiście księgujemy. Niewykorzystane dokumenty nie przechodzą na kolejny miesiąc.' },
  { q: 'Czy są rabaty za dłuższą współpracę albo za płatność z góry?', a: `Nagradzamy staż współpracy, ale zawsze za okresy już przepracowane. Umowa jest na czas nieokreślony i niczego nie podpisujesz na 12 czy 24 miesiące z góry. Po <strong>12 pełnych miesiącach współpracy</strong> naliczamy -5% od stawki abonamentu, począwszy od 13. miesiąca, a po <strong>24 miesiącach</strong> -10%, począwszy od 25. miesiąca. Rabat obowiązuje dalej, dopóki trwa umowa, a przy jej zakończeniu nie żądamy zwrotu tego, co już odliczyliśmy. Niezależnie od stażu działają dwa pozostałe rabaty: -5% po 6 miesiącach dostarczania dokumentów do 7. dnia miesiąca oraz -${bundleDiscount.rate * 100}% za pakiet księgowość + kadry od ${bundleDiscount.minEmployees} pracowników. Osobnego rabatu za opłacenie roku z góry nie prowadzimy - rozliczamy się miesięcznie.` },
  { q: 'Dlaczego naliczacie dopłatę za spóźnione dokumenty?', a: `Dopłata odzwierciedla realny koszt pracy w napiętym terminie i premiuje klientów terminowych. <strong>Do ${surchargeFreeUntilDay}. dnia miesiąca nie ma żadnych dodatkowych kosztów</strong>. Po ${surchargeFreeUntilDay}. dniu mogą one wynieść od +${surcharges[1].pct}% do +${surcharges[surcharges.length - 1].pct}% abonamentu. Pełną tabelę znajdziesz w sekcji "Promujemy terminowość".` },
  { q: 'Ile kosztuje obsługa ulgi IP Box?', a: `Ewidencję IP Box prowadzimy za <strong>${ipBox.monthly} zł netto miesięcznie</strong> dla jednego kwalifikowanego prawa przy KPiR, a każde kolejne prawo to ${ipBox.nextRight} zł. Przy księgach rachunkowych, czyli IP Box w CIT, stawka wynosi ${ipBox.monthlyFk} zł. W tej cenie jest wyliczenie wskaźnika nexus oraz załącznik PIT/IP do rocznego zeznania, więc <strong>nie doliczamy osobnej opłaty za rozliczenie ulgi na koniec roku</strong>. To osobna pozycja, bo ustawa wymaga prowadzenia tej ewidencji na bieżąco przez cały rok, a nie jednorazowo przy zeznaniu. Jeśli potrzebujesz ochrony prawnej, przygotowanie wniosku o interpretację indywidualną kosztuje ${ipBox.interpretation} zł plus ${ipBox.interpretationFee} zł opłaty urzędowej od każdego stanu faktycznego. Szczegóły opisujemy na stronie <a href="/ksiegowosc-dla-programistow#ip-box">księgowości dla programistów</a>.` },
  { q: 'Czy obsługa ZUS właściciela JDG jest dodatkowo płatna?', a: 'Nie. <strong>Jest ona wliczona w abonament</strong> dla każdej formy księgowości: ryczałtu, KPiR i ksiąg handlowych. W wielu innych biurach jest to osobna pozycja na fakturze.' },
  { q: 'Pomagacie założyć firmę? Ile to kosztuje?', a: `Zależy od tego, czy wiesz już, z kim chcesz prowadzić księgowość. <strong>Jeżeli decydujesz się na naszą stałą obsługę, pomoc przy założeniu jednoosobowej działalności jest w cenie współpracy</strong> i nie doliczamy za to nic osobno. Jeżeli jeszcze nie zdecydowałeś, a chcesz szczegółowo omówić start, kupujesz samodzielną <strong>konsultację przed założeniem działalności za ${setupFees.jdg} zł</strong>: policzone warianty opodatkowania, ZUS i ulgi, VAT i VAT-UE, kody PKD, obowiązki po starcie i KSeF. Spółka z o.o., jawna lub komandytowa to <strong>${setupFees.s24} zł</strong>, bo dochodzi kapitał, udziały, zarząd, wybór CIT i przejście przez wzorzec umowy w S24; tę kwotę liczymy niezależnie od decyzji o stałej obsłudze. Jeżeli kupiłeś konsultację, a w ciągu ${setupFees.creditWithinDays} dni od niej wejdzie w życie umowa o obsługę księgową, <strong>zapłaconą kwotę odejmujemy od pierwszej faktury</strong>; po tym terminie rabat nie przysługuje. <strong>Wniosek podpisujesz i składasz sam</strong> i nie jest to nasza ostrożność: wniosku o pierwszy wpis do CEIDG pełnomocnik nie złoży przez internet, a przy spółce umowę podpisują wszyscy wspólnicy, wniosek o wpis wszyscy członkowie zarządu, a przed sądem rejestrowym reprezentować może wyłącznie adwokat albo radca prawny. W rejestracji świadomie nie występujemy jako pełnomocnik. Aport, nietypowa umowa i formy bez wzorca w S24 wymagają notariusza. Szczegóły są dostępne na stronie <a href="/ksiegowosc#zakladanie-firmy">zakładania firmy</a>.` },
  { q: 'Co z roczną deklaracją PIT lub CIT?', a: `Rozliczenie z działalności gospodarczej jest <strong>wliczone w abonament</strong>. Dodatkowo płatne pozostaje osobiste rozliczenie PIT-37/PIT-36 właściciela z dochodów spoza firmy (${personalReturns.personal} zł). PIT-28 z najmu prywatnego kosztuje ${personalReturns.rent} zł, ale <strong>tylko wtedy, gdy jest osobnym drukiem</strong>: najem prywatny rozlicza się ryczałtem, więc u klienta na ryczałcie wchodzi do tego samego PIT-28, który i tak za niego składamy - osobną rubryką, bez dopłaty. Przy skali, liniówce, karcie i w spółce roczne zeznanie z firmy to inny formularz, więc PIT-28 od najmu jest dokumentem dodatkowym.` },
  { q: 'Jak wygląda przeniesienie księgowości z innego biura?', a: 'Przejęcie dokumentacji w trakcie roku jest <strong>bezpłatne</strong>, jeśli dokumenty są uporządkowane. Cały proces formalny (wypowiedzenie, pełnomocnictwa, odbiór ksiąg) bierzemy na siebie. Przeniesienie trwa standardowo od 7 do 14 dni i nie powoduje przerw w rozliczeniach.' },
  { q: 'Ile kosztuje obsługa pracownika?', a: `Pełna obsługa kadrowo-płacowa pracownika na umowie o pracę to <strong>${hrPrice('uop')} zł netto / mies. / osobę</strong>. Umowa zlecenie lub o dzieło z ZUS to ${hrPrice('zlecenie-zus')} zł, a bez ZUS ${hrPrice('zlecenie')} zł. W tej cenie otrzymujesz listy płac, deklaracje ZUS DRA/RCA/RSA, akta osobowe, ewidencję czasu pracy, PIT-11 i PIT-4R.` },
  { q: 'Czy mogę zmienić pakiet w trakcie współpracy?', a: 'Tak, w dowolnym momencie. Zmiana wchodzi w życie od następnego miesiąca rozliczeniowego i nie wymaga aneksu do umowy. Pakiet zmienia się też sam: jeżeli przez <strong>trzy kolejne miesiące</strong> Twoja liczba dokumentów mieści się w innym progu, przechodzimy do niego automatycznie - tak samo w górę, jak i w dół - i zawiadamiamy Cię o tym przed pierwszą fakturą w nowej stawce.' },
  { q: 'Czy są ukryte koszty?', a: `Nie. Cały cennik jest publikowany na stronie oraz stanowi załącznik do umowy. Wiąże Cię wersja z tego załącznika, przez okres w nim wskazany - cennik na stronie jest ofertą dla nowych umów, więc jego późniejsze zmiany nie przenoszą się automatycznie na trwającą współpracę. Dodatkowe opłaty mogą wystąpić wyłącznie za usługi spoza abonamentu, czyli z katalogu usług dodatkowych lub z powodu zaległości w dostarczeniu dokumentów po ${surchargeFreeUntilDay}. dniu miesiąca.` },
];

const year = new Date().getFullYear();
---
<BaseLayout
  title={`Cennik biura rachunkowego ${year} - ceny od ${startsFrom('ryczalt')} zł`}
  description={`Cennik biura rachunkowego Taxun: ryczałt od ${startsFrom('ryczalt')} zł, KPiR od ${startsFrom('kpir')} zł, spółki od ${startsFrom('fk')} zł. KSeF, OCR i portal klienta w cenie. Pełne tabele na stronie.`}
  schema={[offerCatalogSchema, ...packageSchemas]}
  breadcrumbs={breadcrumbs}
>
  <PageHero
    eyebrow={`Cennik ${year}`}
    title="Cennik bez niespodzianek"
    description="Wybierz formę księgowości i sprawdź cenę dla swojego wolumenu dokumentów. KSeF, OCR, JPK_V7, VAT-UE, portal klienta i ZUS właściciela JDG masz zawsze w cenie."
    breadcrumbs={[{ label: 'Cennik' }]}
    align="center"
  />

  <!-- All-inclusive bundle highlight -->
  <section class="section section--tight">
    <div class="container">
      <div class="bundle reveal">
        <div class="bundle__head">
          <span class="eyebrow">W każdym pakiecie</span>
          <h2>Abonament all-inclusive to koniec z dopłatami za standardy</h2>
          <p>KSeF, portal z OCR, ZUS właściciela i roczne zeznanie w typowym biurze bywają osobnymi pozycjami na fakturze - razem <strong>{num(hiddenFeesPerYear.min)}&nbsp;-&nbsp;{zl(hiddenFeesPerYear.max)} rocznie</strong> ponad abonament. U nas mieszczą się w cenie pakietu. Widełki i ich źródło pokazujemy w <a href="#porownanie">zestawieniu z rynkiem</a>.</p>
        </div>
        <ul class="bundle__list">
          {includedInPlan.map((b) => (
            <li>
              <span class="bundle__icon"><Icon name={b.icon} size={18}/></span>
              <span>{b.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Pricing tables -->
  <section class="section section--alt" id="kalkulator">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Pakiet księgowy</span>
        <h2>Pakiet oparty o dokumenty - wybierz formę opodatkowania i wolumen</h2>
        <p>Cena pakietu zależy od tego, ile dokumentów miesięcznie przechodzi przez księgi, a przy ryczałcie i KPiR dodatkowo od statusu VAT. Księgi handlowe mają jedną stawkę dla danego wolumenu. Obowiązki, które nie biorą się z liczby dokumentów, tylko z procedury, stoją osobno w <a href="#moduly">modułach specjalnych</a>.</p>
      </div>

      <div class="pricing-controls">
        <div class="pricing-type" role="tablist" aria-label="Forma księgowości">
          {tables.map((t, i) => (
            <button class={`pricing-type__btn ${i === 0 ? 'is-active' : ''}`} data-form={t.id} role="tab" aria-selected={i === 0}>
              <Icon name={t.icon} size={18}/>
