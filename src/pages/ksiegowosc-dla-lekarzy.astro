const stawkaUslugowa = pct(RYCZALT_USLUGI);

/**
 * Wiersz cennika składany z danych z src/data/pricing.ts - dzięki temu tabela
 * na tej podstronie nie może rozjechać się z cennikiem po zmianie stawek.
 */
const priceRow = (id: 'ryczalt' | 'kpir' | 'fk', upTo: number, situation: string) => {
  const table = tables.find((t) => t.id === id);
  const bucket = table?.buckets.find((b) => b.upTo === upTo);
  const price = table?.hasVat ? bucket?.noVat : bucket?.price;
  return {
    form: table?.shortName ?? '',
    docs: (bucket?.range ?? '').replace(/\s{2,}/g, ' '),
    situation,
    price: typeof price === 'number' ? price : null,
  };
};

