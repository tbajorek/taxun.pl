# ── E-mail ────────────────────────────────────────────────────────────────────
# Wszystkie formularze na stronie (/kontakt oraz kreator wyceny /wycena) wysyłają
# wiadomości tym samym kanałem. Bez EMAIL_DSN i EMAIL_TO formularze odpowiadają
# błędem 503, a użytkownik dostaje komunikat z adresem e-mail biura.

# Połączenie SMTP w formacie DSN (nodemailer). Hasło ze znakami specjalnymi
# trzeba zakodować procentowo (np. @ jako %40).
# Przykłady:
#   smtps://user:password@smtp.example.com:465            (SSL, zalecane)
#   smtp://user:password@smtp.example.com:587             (STARTTLS)
#   smtps://apikey:SG.xxxxx@smtp.sendgrid.net:465         (SendGrid)
#   smtp://login%40example.com:klucz@smtp-relay.brevo.com:587   (Brevo)
#
# Po znaku "@" stoi sama nazwa serwera SMTP - bez drugiego "://" i bez adresu
# strony dostawcy (Brevo: smtp-relay.brevo.com, a nie brevo.com). W panelu
# hostingu wpisujemy samą wartość; przedrostek "EMAIL_DSN=" i cudzysłowy są
# zdejmowane, ale lepiej ich nie wklejać. Zamiennie działa nazwa MAILER_DSN.
EMAIL_DSN=

# Adres, na który trafiają zgłoszenia z formularzy.
EMAIL_TO=biuro@taxun.pl

# Adres nadawcy (opcjonalny). Ustaw, gdy serwer SMTP wymaga, żeby nadawcą było
# konto uwierzytelnione, inne niż odbiorca zgłoszeń. Pusta wartość = EMAIL_TO.
# Można podać sam adres (nazwa nadawcy zostanie dodana automatycznie) albo pełny
# zapis: Taxun <no-reply@taxun.pl>
EMAIL_FROM=

# ── Google Analytics 4 ────────────────────────────────────────────────────────
# Pomiar jest w pełni opcjonalny: bez PUBLIC_GA_ID strona nie ładuje skryptów
# Google i nie zapisuje ciasteczek analitycznych. Szczegóły (lista zdarzeń,
# parametry, wymiary niestandardowe) - docs/analytics.md.

# Measurement ID z GA4 → Administracja → Strumienie danych (G-XXXXXXXXXX).
# Prefiks PUBLIC_ jest wymagany, żeby Astro wstawiło wartość do stron statycznych,
# więc po zmianie trzeba ponownie zbudować i wdrożyć stronę.
PUBLIC_GA_ID=

# Tryb diagnostyczny w przeglądarce: zdarzenia trafiają do GA4 → Administracja →
# DebugView i dodatkowo do konsoli. Zostaw pusty na produkcji.
# Wartości włączające: 1, true, yes, on.
PUBLIC_GA_DEBUG=

# ── Google Ads ────────────────────────────────────────────────────────────────
# Bez PUBLIC_GOOGLE_ADS_ID strona nie konfiguruje tagu reklamowego, nie zapisuje
# ciasteczek _gcl_*, a baner cookies oraz polityka prywatności opisują kategorię
# marketingową jako nieużywaną. Szczegóły - docs/analytics.md.

# Identyfikator konta z Google Ads → Ustawienia → tag Google (AW-XXXXXXXXX).
# Prefiks PUBLIC_ jest wymagany, więc po zmianie trzeba ponownie zbudować
# i wdrożyć stronę.
#
# Konwersji nie wysyłamy tą drogą. Akcje konwersji w Google Ads są typu
# "import z Google Analytics 4" i liczą kluczowe zdarzenia `generate_lead`
# oraz `phone_click` (patrz src/data/conversions.ts). Tag AW- służy tu za łącznik
# konwersji: zapisuje ciasteczka _gcl_*, dzięki którym zgłoszenie da się
# przypisać do kliknięcia w reklamę.
PUBLIC_GOOGLE_ADS_ID=

# ── Google reCAPTCHA v3 ───────────────────────────────────────────────────────
# Klucze utworzysz na https://www.google.com/recaptcha/admin/create (typ: v3).
# Obie zmienne są opcjonalne i działają parami:
#   • brak kluczy      → formularze wysyłają się bez weryfikacji (tryb lokalny),
#   • same klucze      → strona pobiera token, a serwer sprawdza go u Google.
# Klucz publiczny jest wstawiany do stron podczas budowania, więc po jego zmianie
# trzeba ponownie zbudować i wdrożyć stronę.
PUBLIC_RECAPTCHA_SITE_KEY=
# Klucz prywatny - używany wyłącznie po stronie serwera.
RECAPTCHA_SECRET_KEY=

# ── Wstrzymanie przyjmowania nowych klientów ──────────────────────────────────
# Ustawiona zmienna pokazuje na /wycena okno z informacją, że chwilowo nie
# przyjmujemy nowych klientów. Kreator działa dalej - okno da się zamknąć,
# a zgłoszenie wysłać. Pusta wartość albo brak wpisu = brak komunikatu;
# rozpoznajemy też wyłączenia zapisane wprost: 0, false, no, off, nie.
#
# Wartość jest wstawiana do strony podczas budowania, więc po jej zmianie
# trzeba ponownie zbudować i wdrożyć stronę.
NEW_CLIENTS_PAUSED=
