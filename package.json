{
  "name": "taxun",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "covers": "node scripts/optimize-covers.mjs",
    "brand": "node scripts/build-brand.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "assets": "npm run fonts && npm run covers",
    "predev": "npm run assets",
    "dev": "astro dev",
    "prestart": "npm run assets",
    "start": "astro dev",
    "prebuild": "npm run assets",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:blog": "node scripts/verify-blog.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "check:assets": "node scripts/build-fonts.mjs --check && node scripts/optimize-covers.mjs --check"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.7",
    "@types/nodemailer": "^8.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.2.4",
    "fontverter": "^2.0.0",
    "harfbuzzjs": "^1.6.0",
    "nodemailer": "^9.0.5",
    "sharp": "^0.35.3"
  }
}
